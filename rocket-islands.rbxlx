        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- init.server.luau — Точка входа сервера для Rojo
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes       = require(sharedFolder:WaitForChild("Remotes"))
local DataManager   = require(script:WaitForChild("DataManager"))
local PlotManager   = require(script:WaitForChild("PlotManager"))
local FarmManager   = require(script:WaitForChild("FarmManager"))
local RocketManager = require(script:WaitForChild("RocketManager"))

-- 1. Инициализация сетевых событий
Remotes.Init()

-- 2. Инициализация менеджеров
DataManager.Init()
PlotManager.Init()
FarmManager.Init()
RocketManager.Init()

print("==================================================")
print("[Server] Tycoon Rocket Battle запущен через Rojo!")
print("==================================================")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source">-- DataManager.luau - persistent money, launcher count, and player preferences
local Players          = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder     = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes          = require(sharedFolder:WaitForChild("Remotes"))
local Config           = require(sharedFolder:WaitForChild("Config"))

local DataManager = {}

local playerData = {}

local moneyStore = DataStoreService:GetDataStore("TycoonMoney_v3")
local animStore  = DataStoreService:GetDataStore("TycoonAnim_v3")

local function defaultData()
	return { money = Config.START_MONEY, launchers = Config.START_LAUNCHERS, animEnabled = true }
end

local function load(player)
	local uid = tostring(player.UserId)
	local ok, saved = pcall(function()
		return moneyStore:GetAsync(uid)
	end)

	local data = defaultData()
	if ok and saved then
		data.money = tonumber(saved.money) or data.money
		data.launchers = math.clamp(tonumber(saved.launchers) or Config.START_LAUNCHERS, Config.START_LAUNCHERS, Config.MAX_LAUNCHERS)
	end

	local ok2, animVal = pcall(function()
		return animStore:GetAsync(uid)
	end)
	if ok2 and animVal ~= nil then
		data.animEnabled = animVal
	end

	playerData[player] = data
end

local function save(player)
	local data = playerData[player]
	if not data then return end
	local uid = tostring(player.UserId)
	pcall(function()
		moneyStore:UpdateAsync(uid, function()
			return { money = data.money, launchers = data.launchers }
		end)
	end)
	pcall(function()
		animStore:SetAsync(uid, data.animEnabled)
	end)
end

function DataManager.Init()
	Players.PlayerAdded:Connect(function(player)
		load(player)
		task.delay(1, function()
			if player and player.Parent then
				DataManager.SendUpdate(player)
			end
		end)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		load(player)
		task.delay(1, function()
			if player and player.Parent then
				DataManager.SendUpdate(player)
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		playerData[player] = nil
	end)

	local setAnim = Remotes.Get("SetAnimSetting")
	setAnim.OnServerEvent:Connect(function(player, enabled)
		local data = playerData[player]
		if data then
			data.animEnabled = enabled == true
			pcall(function()
				animStore:SetAsync(tostring(player.UserId), data.animEnabled)
			end)
		end
	end)

	local getAnim = Remotes.Get("GetAnimSetting")
	getAnim.OnServerInvoke = function(player)
		local data = playerData[player]
		return data and data.animEnabled ~= false
	end

end

function DataManager.GetData(player)
	return playerData[player]
end

function DataManager.GetMoney(player)
	local data = playerData[player]
	return data and data.money or 0
end

function DataManager.AddMoney(player, amount)
	local data = playerData[player]
	if data then
		data.money = math.max(0, data.money + amount)
		DataManager.SendUpdate(player)
	end
end

function DataManager.GetLauncherCount(player)
	local data = playerData[player]
	return data and data.launchers or 0
end

function DataManager.BuyNextLauncher(player)
	local data = playerData[player]
	if not data then return false, "Данные игрока загружаются" end
	if data.launchers &gt;= Config.MAX_LAUNCHERS then return false, "Все 6 установок уже построены" end
	local nextCount = data.launchers + 1
	local cost = Config.LAUNCHER_COSTS[nextCount]
	if data.money &lt; cost then return false, string.format("Нужно ещё $%d", cost - data.money) end
	data.money -= cost
	data.launchers = nextCount
	DataManager.SendUpdate(player)
	return true, nextCount
end

function DataManager.SendUpdate(player)
	local data = playerData[player]
	if not data then return end
	local ev = Remotes.Get("UpdateData")
	ev:FireClient(player, {
		money = data.money,
		launchers = data.launchers,
		animEnabled = data.animEnabled,
	})
end

return DataManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">FarmManager</string>
          <string name="Source">-- FarmManager.luau — Строительство зданий, логика доходов, получение урона и КД восстановления
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config            = require(sharedFolder:WaitForChild("Config"))
local Remotes           = require(sharedFolder:WaitForChild("Remotes"))
local DataManager       = require(script.Parent:WaitForChild("DataManager"))
local PlotManager       = require(script.Parent:WaitForChild("PlotManager"))

local FarmManager = {}

-- plotFarms[plotId][slotIndex] = { tier, hp, maxHp, alive, rebuildTimer, folder, body, hpBar, statusLabel }
local plotFarms = {}

-- Генерация кусочка суши и моста при покупке слота
local function buildTerritory(plotId, slotIndex)
	local plot = PlotManager.GetPlot(plotId)
	local slotInfo = plot.slots[slotIndex]
	local center = slotInfo.center
	local edgePos = slotInfo.edgePos
	
	local territoryFolder = Instance.new("Folder")
	territoryFolder.Name = "Territory_" .. slotIndex
	territoryFolder.Parent = plot.folder

	local dist = (center - edgePos).Magnitude

	-- Мост
	local bridge = Instance.new("Part")
	bridge.Name = "Bridge"
	bridge.Anchored = true
	bridge.Size = Vector3.new(6, 1, dist)
	bridge.CFrame = CFrame.lookAt(edgePos, center) * CFrame.new(0, 1.5, -dist / 2)
	bridge.Color = Color3.fromRGB(100, 70, 40)
	bridge.Material = Enum.Material.Wood
	bridge.Parent = territoryFolder

	-- Опоры моста
	local support = Instance.new("Part")
	support.Name = "BridgeSupport"
	support.Anchored = true
	support.Shape = Enum.PartType.Cylinder
	support.Size = Vector3.new(dist, 1.5, 1.5)
	support.Orientation = bridge.Orientation + Vector3.new(0, 90, 0)
	support.Position = bridge.Position - Vector3.new(0, 1, 0)
	support.Color = Color3.fromRGB(50, 35, 20)
	support.Material = Enum.Material.Wood
	support.Parent = territoryFolder

	-- Sand platform keeps every expansion in the island theme.
	local top = Instance.new("Part")
	top.Name = "IslandTop"
	top.Anchored = true
	top.Shape = Enum.PartType.Cylinder
	top.Size = Vector3.new(4, Config.SLOT_PLATFORM_SIZE, Config.SLOT_PLATFORM_SIZE)
	top.Orientation = Vector3.new(0, 0, 90)
	top.Position = center
	top.Color = Color3.fromRGB(232, 204, 139)
	top.Material = Enum.Material.Sand
	top.Parent = territoryFolder

	-- Платформа - Камень
	local bottom = Instance.new("Part")
	bottom.Name = "RockBottom"
	bottom.Anchored = true
	bottom.Shape = Enum.PartType.Cylinder
	bottom.Size = Vector3.new(16, Config.SLOT_PLATFORM_SIZE * 0.8, Config.SLOT_PLATFORM_SIZE * 0.8)
	bottom.Orientation = Vector3.new(0, 0, 90)
	bottom.Position = center - Vector3.new(0, 10, 0)
	bottom.Color = Color3.fromRGB(91, 82, 71)
	bottom.Material = Enum.Material.Rock
	bottom.Parent = territoryFolder

	-- Неоновый обод
	local border = Instance.new("Part")
	border.Name = "NeonBorder"
	border.Anchored = true
	border.Shape = Enum.PartType.Cylinder
	border.Size = Vector3.new(1.5, Config.SLOT_PLATFORM_SIZE + 1.5, Config.SLOT_PLATFORM_SIZE + 1.5)
	border.Orientation = Vector3.new(0, 0, 90)
	border.Position = center + Vector3.new(0, 2, 0)
	border.Color = plot.themeColor
	border.Material = Enum.Material.Neon
	border.CanCollide = false
	border.Parent = territoryFolder
	
	return territoryFolder
end

-- Уникальные 3D модели зданий
local function buildBuildingModel(plotId, slotIndex, tier, territoryFolder)
	local plot = PlotManager.GetPlot(plotId)
	local slotInfo = plot.slots[slotIndex]
	local center = slotInfo.center
	local farmConfig = Config.FARM_TYPES[tier]

	local farmFolder = Instance.new("Folder")
	farmFolder.Name = "FarmSlot_" .. slotIndex
	farmFolder:SetAttribute("Alive", true)
	farmFolder.Parent = territoryFolder

	local mainBody -- Центральная часть для Gui
	
	-- База для всех зданий
	local base = Instance.new("Part")
	base.Anchored = true
	base.Size = Vector3.new(16, 1, 16)
	base.Position = center + Vector3.new(0, 2.5, 0)
	base.Color = Color3.fromRGB(40, 40, 45)
	base.Material = Enum.Material.DiamondPlate
	base.Parent = farmFolder
	mainBody = base

	local heightOffset = 3

	if tier == 1 then
		-- Солнечная ферма
		local pillar = Instance.new("Part")
		pillar.Anchored = true
		pillar.Size = Vector3.new(2, 8, 2)
		pillar.Position = base.Position + Vector3.new(0, 4, 0)
		pillar.Color = Color3.fromRGB(150, 150, 150)
		pillar.Parent = farmFolder
		
		local panel = Instance.new("Part")
		panel.Anchored = true
		panel.Size = Vector3.new(12, 0.5, 12)
		panel.CFrame = CFrame.new(pillar.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(math.rad(30), 0, 0)
		panel.Color = farmConfig.color
		panel.Material = farmConfig.material
		panel.Parent = farmFolder
		mainBody = panel
		heightOffset = 5

	elseif tier == 2 then
		-- Кристальная шахта
		mainBody = Instance.new("Part")
		mainBody.Anchored = true
		mainBody.Size = Vector3.new(10, 6, 10)
		mainBody.Position = base.Position + Vector3.new(0, 3, 0)
		mainBody.Color = Color3.fromRGB(60, 50, 60)
		mainBody.Material = Enum.Material.Slate
		mainBody.Parent = farmFolder
		
		for i = 1, 4 do
			local crystal = Instance.new("Part")
			crystal.Anchored = true
			crystal.Shape = Enum.PartType.Ball
			crystal.Size = Vector3.new(4, 12, 4)
			crystal.CFrame = CFrame.new(mainBody.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(math.rad(math.random(-30, 30)), math.rad(i * 90), math.rad(30))
			crystal.Color = farmConfig.color
			crystal.Material = Enum.Material.Neon
			crystal.Parent = farmFolder
		end
		heightOffset = 10

	elseif tier == 3 then
		-- Био-Лаборатория
		mainBody = Instance.new("Part")
		mainBody.Anchored = true
		mainBody.Shape = Enum.PartType.Cylinder
		mainBody.Size = Vector3.new(10, 14, 14)
		mainBody.Orientation = Vector3.new(0, 0, 90)
		mainBody.Position = base.Position + Vector3.new(0, 5, 0)
		mainBody.Color = Color3.fromRGB(150, 150, 150)
		mainBody.Material = Enum.Material.Metal
		mainBody.Parent = farmFolder

		local dome = Instance.new("Part")
		dome.Anchored = true
		dome.Shape = Enum.PartType.Ball
		dome.Size = Vector3.new(12, 12, 12)
		dome.Position = mainBody.Position + Vector3.new(0, 2, 0)
		dome.Color = Color3.fromRGB(200, 255, 200)
		dome.Material = Enum.Material.Glass
		dome.Transparency = 0.5
		dome.Parent = farmFolder

		local fluid = Instance.new("Part")
		fluid.Anchored = true
		fluid.Shape = Enum.PartType.Ball
		fluid.Size = Vector3.new(8, 8, 8)
		fluid.Position = dome.Position
		fluid.Color = farmConfig.color
		fluid.Material = Enum.Material.Neon
		fluid.Parent = farmFolder
		heightOffset = 9

	elseif tier == 4 then
		-- Плазменный генератор
		mainBody = Instance.new("Part")
		mainBody.Anchored = true
		mainBody.Shape = Enum.PartType.Cylinder
		mainBody.Size = Vector3.new(12, 8, 8)
		mainBody.Orientation = Vector3.new(0, 0, 90)
		mainBody.Position = base.Position + Vector3.new(0, 6, 0)
		mainBody.Color = Color3.fromRGB(40, 40, 40)
		mainBody.Material = Enum.Material.Metal
		mainBody.Parent = farmFolder

		local orb = Instance.new("Part")
		orb.Anchored = true
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(8, 8, 8)
		orb.Position = mainBody.Position + Vector3.new(0, 8, 0)
		orb.Color = farmConfig.color
		orb.Material = Enum.Material.Neon
		orb.Parent = farmFolder
		heightOffset = 18

	elseif tier == 5 then
		-- Квантовый реактор
		mainBody = Instance.new("Part")
		mainBody.Anchored = true
		mainBody.Size = Vector3.new(10, 16, 10)
		mainBody.Position = base.Position + Vector3.new(0, 8, 0)
		mainBody.Color = Color3.fromRGB(20, 20, 20)
		mainBody.Material = Enum.Material.Metal
		mainBody.Parent = farmFolder

		local ring = Instance.new("Part")
		ring.Anchored = true
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(4, 20, 20)
		ring.Orientation = Vector3.new(45, 45, 90)
		ring.Position = mainBody.Position
		ring.Color = farmConfig.color
		ring.Material = Enum.Material.Neon
		ring.CanCollide = false
		ring.Parent = farmFolder

		local core = Instance.new("Part")
		core.Anchored = true
		core.Shape = Enum.PartType.Ball
		core.Size = Vector3.new(10, 10, 10)
		core.Position = mainBody.Position
		core.Color = farmConfig.color
		core.Material = Enum.Material.ForceField
		core.Parent = farmFolder
		heightOffset = 12
	end

	-- 3D Информационная панель над зданием
	local gui = Instance.new("BillboardGui")
	gui.Name = "StatusGui"
	gui.Size = UDim2.new(0, 180, 0, 50)
	gui.StudsOffset = Vector3.new(0, heightOffset, 0)
	gui.AlwaysOnTop = false
	gui.Parent = mainBody

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0, 18)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = string.format("%s (Тир %d)", farmConfig.name, tier)
	nameLabel.TextColor3 = Color3.fromRGB(255, 220, 50)
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Parent = gui

	local hpBg = Instance.new("Frame")
	hpBg.Name = "HpBg"
	hpBg.Size = UDim2.new(1, 0, 0, 12)
	hpBg.Position = UDim2.new(0, 0, 0, 20)
	hpBg.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	hpBg.BorderSizePixel = 0
	hpBg.Parent = gui

	local hpBar = Instance.new("Frame")
	hpBar.Name = "HpBar"
	hpBar.Size = UDim2.new(1, 0, 1, 0)
	hpBar.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
	hpBar.BorderSizePixel = 0
	hpBar.Parent = hpBg

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, 0, 0, 14)
	statusLabel.Position = UDim2.new(0, 0, 0, 34)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = "+$" .. farmConfig.income
	statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
	statusLabel.TextScaled = true
	statusLabel.Font = Enum.Font.GothamMedium
	statusLabel.Parent = gui

	return farmFolder, mainBody, hpBar, statusLabel
end

local function spawnBuilding(plotId, slotIndex, tier)
	if not plotFarms[plotId] then plotFarms[plotId] = {} end

	local oldData = plotFarms[plotId][slotIndex]
	if oldData and oldData.folder then
		oldData.folder:Destroy()
	end
	
	local plot = PlotManager.GetPlot(plotId)
	
	-- Если территории еще нет, строим её
	local territoryFolder = plot.folder:FindFirstChild("Territory_" .. slotIndex)
	if not territoryFolder then
		territoryFolder = buildTerritory(plotId, slotIndex)
	end

	local farmConfig = Config.FARM_TYPES[tier]
	local folder, body, hpBar, statusLabel = buildBuildingModel(plotId, slotIndex, tier, territoryFolder)

	if plot and plot.slots[slotIndex] then
		plot.slots[slotIndex].buyPad.Transparency = 1
		plot.slots[slotIndex].buyPad.CanCollide = false
		plot.slots[slotIndex].buyText.Visible = false
	end
	
	-- Активация кнопки СЛЕДУЮЩЕГО слота (последовательная прокачка)
	local nextSlot = slotIndex + 1
	if plot and plot.slots[nextSlot] and not (plotFarms[plotId] and plotFarms[plotId][nextSlot]) then
		plot.slots[nextSlot].buyPad.Transparency = 0
		plot.slots[nextSlot].buyPad.CanCollide = true
		plot.slots[nextSlot].buyText.Visible = true
	end

	plotFarms[plotId][slotIndex] = {
		tier = tier,
		hp = farmConfig.maxHp,
		maxHp = farmConfig.maxHp,
		alive = true,
		folder = folder,
		body = body,
		hpBar = hpBar,
		statusLabel = statusLabel,
		rebuildTimer = 0,
	}

	Remotes.Get("BuildingStateChanged"):FireAllClients(plotId, slotIndex, {
		tier = tier,
		hp = farmConfig.maxHp,
		maxHp = farmConfig.maxHp,
		alive = true,
		rebuildTimer = 0,
	})
end

function FarmManager.BuySlot(player, slotIndex)
	local plotId = select(1, PlotManager.GetPlotByPlayer(player))
	if not plotId then return end

	-- Проверка последовательности прокачки: можно купить слот N, только если есть слот N-1
	if slotIndex &gt; 1 and (not plotFarms[plotId] or not plotFarms[plotId][slotIndex - 1]) then
		return
	end

	local farmConfig = Config.FARM_TYPES[slotIndex]
	if not farmConfig then return end

	local currentData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	if currentData then return end

	local playerMoney = DataManager.GetMoney(player)
	if playerMoney &gt;= farmConfig.cost then
		DataManager.AddMoney(player, -farmConfig.cost)
		spawnBuilding(plotId, slotIndex, slotIndex)
		print(string.format("[FarmManager] %s открыл новую территорию и построил %s!", player.Name, farmConfig.name))
	end
end

local function destroyBuilding(plotId, slotIndex)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	if not slotData or not slotData.alive then return end

	slotData.alive = false
	if slotData.folder then slotData.folder:SetAttribute("Alive", false) end
	local farmConfig = Config.FARM_TYPES[slotData.tier]
	local cd = farmConfig.cooldown

	if slotData.folder then
		for _, part in ipairs(slotData.folder:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Color = Color3.fromRGB(60, 60, 65)
				part.Material = Enum.Material.Concrete
			end
		end
	end

	if slotData.hpBar then slotData.hpBar.Size = UDim2.new(0, 0, 1, 0) end

	task.spawn(function()
		for timeLeft = cd, 1, -1 do
			if not slotData or slotData.alive then break end
			slotData.rebuildTimer = timeLeft
			if slotData.statusLabel then
				slotData.statusLabel.Text = string.format("Ремонт %dс", timeLeft)
				slotData.statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			end

			Remotes.Get("BuildingStateChanged"):FireAllClients(plotId, slotIndex, {
				tier = slotData.tier,
				hp = 0,
				maxHp = slotData.maxHp,
				alive = false,
				rebuildTimer = timeLeft,
			})
			task.wait(1)
		end

		local plot = PlotManager.GetPlot(plotId)
		if plot and plot.owner then
			spawnBuilding(plotId, slotIndex, slotData.tier)
			print(string.format("[FarmManager] Остров #%d Слот #%d заново восстановлен!", plotId, slotIndex))
		end
	end)
end

function FarmManager.Init()
	for plotId, plot in pairs(PlotManager.GetAllPlots()) do
		for slotIdx, slotInfo in ipairs(plot.slots) do
			slotInfo.buyPad.Touched:Connect(function(hit)
				local char = hit.Parent
				local player = Players:GetPlayerFromCharacter(char)
				if player and plot.owner == player then
					FarmManager.BuySlot(player, slotIdx)
				end
			end)
		end
	end

	local buyEvent = Remotes.Get("BuyBuildingSlot")
	buyEvent.OnServerEvent:Connect(function(player, slotIndex)
		if type(slotIndex) == "number" then
			FarmManager.BuySlot(player, slotIndex)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.wait(1.5)
		local plotId = select(1, PlotManager.GetPlotByPlayer(player))
		if plotId then
			if not plotFarms[plotId] then plotFarms[plotId] = {} end
			
			-- Делаем кнопку первого слота видимой
			local plot = PlotManager.GetPlot(plotId)
			if plot and plot.slots[1] then
				plot.slots[1].buyPad.Transparency = 0
				plot.slots[1].buyPad.CanCollide = true
				plot.slots[1].buyText.Visible = true
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local plotId = player:GetAttribute("PlotId") or select(1, PlotManager.GetPlotByPlayer(player))
		if plotId and plotFarms[plotId] then
			for _, slotData in pairs(plotFarms[plotId]) do
				if slotData.folder then slotData.folder:Destroy() end
			end
			plotFarms[plotId] = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.FARM_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				local plotId = select(1, PlotManager.GetPlotByPlayer(player))
				if plotId and plotFarms[plotId] then
					for slotIdx, slotData in pairs(plotFarms[plotId]) do
						if slotData and slotData.alive then
							local farmConfig = Config.FARM_TYPES[slotData.tier]
							if farmConfig then
								DataManager.AddMoney(player, farmConfig.income)
								local plot = PlotManager.GetPlot(plotId)
								if plot and plot.slots[slotIdx] then
									Remotes.Get("SpawnIncomeFX"):FireClient(player, plot.slots[slotIdx].center + Vector3.new(0, 10, 0), farmConfig.income)
								end
							end
						end
					end
				end
			end
		end
	end)
end

function FarmManager.GetSlotTargetPosition(plotId, slotIndex)
	local plot = PlotManager.GetPlot(plotId)
	if not plot or not plot.slots[slotIndex] then
		return plot and plot.center or Vector3.zero
	end
	return plot.slots[slotIndex].center + Vector3.new(0, 6, 0)
end

function FarmManager.IsSlotAlive(plotId, slotIndex)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	return slotData ~= nil and slotData.alive == true
end

function FarmManager.DamageAtSlot(plotId, slotIndex, damage)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	if not slotData or not slotData.alive then return false end

	slotData.hp = math.max(0, slotData.hp - damage)
	if slotData.hpBar then
		slotData.hpBar.Size = UDim2.new(math.clamp(slotData.hp / slotData.maxHp, 0, 1), 0, 1, 0)
	end

	if slotData.hp &lt;= 0 then
		destroyBuilding(plotId, slotIndex)
		return true
	end
	return false
end

function FarmManager.GetAllFarmData()
	return plotFarms
end

return FarmManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">PlotManager</string>
          <string name="Source">-- PlotManager.luau - ocean world, sandy islands, wildlife, and launchers

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)
local Config            = require(sharedFolder:WaitForChild("Config"))

local PlotManager = {}

local plots = {}
local playerPlot = {}

local PLOT_THEME_COLORS = {
	Color3.fromRGB(46, 117, 224),
	Color3.fromRGB(224, 76, 46),
	Color3.fromRGB(46, 200, 90),
	Color3.fromRGB(230, 180, 30),
	Color3.fromRGB(170, 50, 230),
	Color3.fromRGB(40, 210, 210),
}

local function makePart(parent, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildShark(parent, index)
	local model = Instance.new("Model")
	model.Name = "Shark_" .. index
	model.Parent = parent

	local radius = 120 + (index % 3) * 55
	local angle = index / 10 * math.pi * 2
	local body = makePart(model, "Body", Vector3.new(4, 4, 13), CFrame.new(), Color3.fromRGB(67, 88, 101), Enum.Material.SmoothPlastic)
	body.Shape = Enum.PartType.Ball
	body.CanCollide = false
	local fin = makePart(model, "Fin", Vector3.new(0.7, 5, 5), CFrame.new(), body.Color, Enum.Material.SmoothPlastic)
	fin.CanCollide = false
	local tail = makePart(model, "Tail", Vector3.new(0.8, 7, 5), CFrame.new(), body.Color, Enum.Material.SmoothPlastic)
	tail.CanCollide = false
	model.PrimaryPart = body

	task.spawn(function()
		local t = angle
		while model.Parent do
			t += 0.007
			local position = Vector3.new(math.cos(t) * radius, Config.WATER_LEVEL + 1.2, math.sin(t) * radius)
			local nextPosition = Vector3.new(math.cos(t + 0.03) * radius, position.Y, math.sin(t + 0.03) * radius)
			model:PivotTo(CFrame.lookAt(position, nextPosition))
			fin.CFrame = body.CFrame * CFrame.new(0, 3, 1) * CFrame.Angles(0, 0, math.rad(45))
			tail.CFrame = body.CFrame * CFrame.new(0, 0, 7)
			task.wait(0.05)
		end
	end)
end

local function buildOcean()
	local terrain = workspace.Terrain
	terrain:Clear()
	terrain.WaterColor = Color3.fromRGB(18, 126, 170)
	terrain.WaterTransparency = 0.28
	terrain.WaterReflectance = 0.22
	terrain.WaterWaveSize = 0.22
	terrain.WaterWaveSpeed = 11
	terrain:FillBlock(CFrame.new(0, Config.WATER_LEVEL - 20, 0), Vector3.new(Config.WORLD_SIZE, 40, Config.WORLD_SIZE), Enum.Material.Water)

	local world = Instance.new("Folder")
	world.Name = "OceanWildlife"
	world.Parent = workspace
	for index = 1, 10 do
		buildShark(world, index)
	end
end

local function buildIslandModel(plotId, position)
	local folder = Instance.new("Folder")
	folder.Name = "Plot_" .. plotId
	folder:SetAttribute("PlotId", plotId)
	folder:SetAttribute("OwnerUserId", 0)
	folder.Parent = workspace

	local themeColor = PLOT_THEME_COLORS[plotId] or Color3.fromRGB(150, 150, 150)

	-- Wide sand cap above a submerged rock foundation.
	local islandTop = Instance.new("Part")
	islandTop.Name = "IslandTop"
	islandTop.Anchored = true
	islandTop.Shape = Enum.PartType.Cylinder
	islandTop.Size = Vector3.new(7, Config.PLOT_CENTER_SIZE, Config.PLOT_CENTER_SIZE)
	islandTop.Orientation = Vector3.new(0, 0, 90)
	islandTop.Position = position
	islandTop.Color = Color3.fromRGB(232, 204, 139)
	islandTop.Material = Enum.Material.Sand
	islandTop.Parent = folder

	-- 2. Скалистый поддон (чтобы остров уходил под воду)
	local rockBottom = Instance.new("Part")
	rockBottom.Name = "RockBottom"
	rockBottom.Anchored = true
	rockBottom.Shape = Enum.PartType.Cylinder
	rockBottom.Size = Vector3.new(20, Config.PLOT_CENTER_SIZE * 0.85, Config.PLOT_CENTER_SIZE * 0.85)
	rockBottom.Orientation = Vector3.new(0, 0, 90)
	rockBottom.Position = position - Vector3.new(0, 10, 0)
	rockBottom.Color = Color3.fromRGB(91, 82, 71)
	rockBottom.Material = Enum.Material.Rock
	rockBottom.Parent = folder

	-- 3. Точка спавна игрока
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlotSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = position + Vector3.new(0, 2.5, -15)
	spawn.Color = themeColor
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = false
	spawn.Duration = 0
	spawn.Parent = folder

	-- 4. Вывеска острова
	local signPart = Instance.new("Part")
	signPart.Name = "OwnerSign"
	signPart.Anchored = true
	signPart.Size = Vector3.new(12, 4, 1)
	signPart.Position = position + Vector3.new(0, 6, -24)
	signPart.Color = Color3.fromRGB(30, 30, 35)
	signPart.Material = Enum.Material.SmoothPlastic
	signPart.Parent = folder

	local signBb = Instance.new("BillboardGui")
	signBb.Size = UDim2.new(0, 280, 0, 70)
	signBb.StudsOffset = Vector3.new(0, 1, 0)
	signBb.AlwaysOnTop = false
	signBb.Parent = signPart

	local signText = Instance.new("TextLabel")
	signText.Size = UDim2.new(1, 0, 1, 0)
	signText.BackgroundTransparency = 1
	signText.Text = "Остров " .. plotId
	signText.TextColor3 = Color3.fromRGB(255, 255, 255)
	signText.TextScaled = true
	signText.Font = Enum.Font.GothamBold
	signText.Parent = signBb

	-- Launcher models are added here as the player expands from one to six.
	local siloFolder = Instance.new("Folder")
	siloFolder.Name = "RocketSilo"
	siloFolder.Parent = folder

	-- 6. Кнопки покупки (Зеленые круги на краю центрального острова)
	local slotsData = {}
	for slotIdx, offset in ipairs(Config.SLOT_OFFSETS) do
		local farmConfig = Config.FARM_TYPES[slotIdx]
		
		-- Кнопка ставится на краю центрального острова по направлению к будущей платформе
		local dir = offset.Unit
		local edgePos = position + dir * ((Config.PLOT_CENTER_SIZE / 2) - 3)
		
		local buyPad = Instance.new("Part")
		buyPad.Name = "BuyPad_" .. slotIdx
		buyPad.Shape = Enum.PartType.Cylinder
		buyPad.Anchored = true
		buyPad.Size = Vector3.new(0.6, 6, 6) -- Тонкий круг
		buyPad.Orientation = Vector3.new(0, 0, 90) -- Лежит плашмя
		buyPad.Position = edgePos + Vector3.new(0, 2.3, 0)
		buyPad.Color = Color3.fromRGB(50, 220, 80) -- Зеленый круг
		buyPad.Material = Enum.Material.Neon
		-- Изначально скрываем кнопки 2-5
		if slotIdx &gt; 1 then
			buyPad.Transparency = 1
			buyPad.CanCollide = false
		end
		buyPad.Parent = folder

		local buyBb = Instance.new("BillboardGui")
		buyBb.Name = "BuyGui"
		buyBb.Size = UDim2.new(0, 180, 0, 55)
		buyBb.StudsOffset = Vector3.new(0, 3.5, 0)
		buyBb.AlwaysOnTop = false
		buyBb.Parent = buyPad

		local buyText = Instance.new("TextLabel")
		buyText.Size = UDim2.new(1, 0, 1, 0)
		buyText.BackgroundTransparency = 1
		buyText.Text = string.format("%s  $%d", farmConfig.name, farmConfig.cost)
		buyText.TextColor3 = Color3.fromRGB(255, 255, 255)
		buyText.TextScaled = true
		buyText.Font = Enum.Font.GothamBold
		buyText.Parent = buyBb
		if slotIdx &gt; 1 then
			buyText.Visible = false
		end

		slotsData[slotIdx] = {
			center = position + offset, -- Истинный центр будущего здания
			edgePos = edgePos,          -- Позиция кнопки и начала моста
			buyPad = buyPad,
			buyText = buyText,
		}
	end

	plots[plotId] = {
		owner = nil,
		folder = folder,
		center = position,
		signText = signText,
		spawn = spawn,
		slots = slotsData,
		themeColor = themeColor,
		launchers = {},
	}
end

local function assignPlayerToPlot(player)
	for id, plot in pairs(plots) do
		if plot.owner == nil then
			plot.owner = player
			playerPlot[player] = id
			player:SetAttribute("PlotId", id)
			plot.folder:SetAttribute("OwnerUserId", player.UserId)
			plot.signText.Text = player.DisplayName
			player.RespawnLocation = plot.spawn

			local char = player.Character or player.CharacterAdded:Wait()
			if char then
				task.wait(0.2)
				char:PivotTo(plot.spawn.CFrame + Vector3.new(0, 4, 0))
			end

			print(string.format("[PlotManager] %s успешно назначен на Остров #%d", player.Name, id))
			break
		end
	end
end

function PlotManager.Init()
	local oldWildlife = workspace:FindFirstChild("OceanWildlife")
	if oldWildlife then oldWildlife:Destroy() end
	buildOcean()

	for i, pos in ipairs(Config.PLOT_POSITIONS) do
		buildIslandModel(i, pos)
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			local plotId = playerPlot[player]
			if plotId and plots[plotId] then
				task.wait(0.2)
				char:PivotTo(plots[plotId].spawn.CFrame + Vector3.new(0, 4, 0))
			end
		end)
		assignPlayerToPlot(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if not playerPlot[player] then
			assignPlayerToPlot(player)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		local id = playerPlot[player]
		if id then
			local plot = plots[id]
			if plot then
				plot.owner = nil
				plot.folder:SetAttribute("OwnerUserId", 0)
				plot.signText.Text = "Остров " .. id
				plot.folder.RocketSilo:ClearAllChildren()
				plot.launchers = {}
			end
			playerPlot[player] = nil
		end
	end)
end

function PlotManager.CreateLauncher(player, launcherIndex)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	if not plot or plot.launchers[launcherIndex] then return plot and plot.launchers[launcherIndex] end
	local offset = Config.LAUNCHER_OFFSETS[launcherIndex]
	if not offset then return nil end

	local model = Instance.new("Model")
	model.Name = "Launcher_" .. launcherIndex
	model:SetAttribute("LauncherIndex", launcherIndex)
	model.Parent = plot.folder:FindFirstChild("RocketSilo")
	local position = plot.center + offset + Vector3.new(0, 4, 0)
	local base = makePart(model, "Base", Vector3.new(12, 2, 12), CFrame.new(position), Color3.fromRGB(52, 60, 67), Enum.Material.DiamondPlate)
	local rim = makePart(model, "ReadyRim", Vector3.new(1, 10, 10), CFrame.new(position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), plot.themeColor, Enum.Material.Neon)
	rim.Shape = Enum.PartType.Cylinder
	rim.CanCollide = false
	local rocket = makePart(model, "Rocket", Vector3.new(12, 3.2, 3.2), CFrame.new(position + Vector3.new(0, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(224, 230, 232), Enum.Material.Metal)
	rocket.Shape = Enum.PartType.Cylinder
	local nose = makePart(model, "Nose", Vector3.new(3.5, 3.5, 3.5), CFrame.new(position + Vector3.new(0, 14.5, 0)), plot.themeColor, Enum.Material.Neon)
	nose.Shape = Enum.PartType.Ball
	nose.CanCollide = false
	model.PrimaryPart = base
	plot.launchers[launcherIndex] = { model = model, rocket = rocket, nose = nose, rim = rim, origin = nose.Position }
	return plot.launchers[launcherIndex]
end

function PlotManager.SetLauncherReady(player, launcherIndex, ready)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	local launcher = plot and plot.launchers[launcherIndex]
	if not launcher then return end
	launcher.rocket.Transparency = ready and 0 or 1
	launcher.nose.Transparency = ready and 0 or 1
	launcher.rim.Color = ready and plot.themeColor or Color3.fromRGB(85, 91, 95)
end

function PlotManager.GetLauncherOrigin(player, launcherIndex)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	local launcher = plot and plot.launchers[launcherIndex]
	return launcher and launcher.origin
end

function PlotManager.GetPlotByPlayer(player)
	local id = playerPlot[player]
	return id, plots[id]
end

function PlotManager.GetPlot(plotId)
	return plots[plotId]
end

function PlotManager.GetAllPlots()
	return plots
end

function PlotManager.GetPlayerByPlot(plotId)
	local plot = plots[plotId]
	return plot and plot.owner
end

return PlotManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">RocketManager</string>
          <string name="Source">-- RocketManager.luau - launcher purchases, reloads, and authoritative combat
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config            = require(sharedFolder:WaitForChild("Config"))
local Remotes           = require(sharedFolder:WaitForChild("Remotes"))
local DataManager       = require(script.Parent:WaitForChild("DataManager"))
local PlotManager       = require(script.Parent:WaitForChild("PlotManager"))
local FarmManager       = require(script.Parent:WaitForChild("FarmManager"))

local RocketManager = {}

local launcherReady = {}
local lastRequest = {}

local function notify(player, message, kind)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

local function sendRocketState(player)
	local count = DataManager.GetLauncherCount(player)
	local readyCount = 0
	local reloads = {}
	local now = workspace:GetServerTimeNow()
	for index = 1, count do
		local readyAt = launcherReady[player] and launcherReady[player][index] or 0
		if readyAt &lt;= now then readyCount += 1 else reloads[index] = math.max(0, readyAt - now) end
	end
	Remotes.Get("RocketStateChanged"):FireClient(player, {
		launchers = count,
		ready = readyCount,
		reloads = reloads,
	})
end

local function createOwnedLaunchers(player)
	launcherReady[player] = launcherReady[player] or {}
	for index = 1, DataManager.GetLauncherCount(player) do
		PlotManager.CreateLauncher(player, index)
		launcherReady[player][index] = launcherReady[player][index] or 0
	end
	sendRocketState(player)
end

local function takeReadyLauncher(player)
	local now = workspace:GetServerTimeNow()
	for index = 1, DataManager.GetLauncherCount(player) do
		if (launcherReady[player] and launcherReady[player][index] or 0) &lt;= now then
			launcherReady[player][index] = now + Config.ROCKET_RELOAD
			PlotManager.SetLauncherReady(player, index, false)
			sendRocketState(player)
			task.delay(Config.ROCKET_RELOAD, function()
				if player.Parent and launcherReady[player] and launcherReady[player][index] then
					launcherReady[player][index] = 0
					PlotManager.SetLauncherReady(player, index, true)
					sendRocketState(player)
				end
			end)
			return index
		end
	end
	return nil
end

function RocketManager.Init()
	local launchEvent = Remotes.Get("LaunchRocket")
	local firedEvent = Remotes.Get("RocketFired")

	local function setupPlayer(player)
		task.spawn(function()
			for _ = 1, 30 do
				if not player.Parent then return end
				local plotId = select(1, PlotManager.GetPlotByPlayer(player))
				if plotId and DataManager.GetData(player) then
					createOwnedLaunchers(player)
					return
				end
				task.wait(0.2)
			end
		end)
	end
	game:GetService("Players").PlayerAdded:Connect(setupPlayer)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		launcherReady[player] = nil
		lastRequest[player] = nil
	end)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do setupPlayer(player) end

	Remotes.Get("BuyLauncher").OnServerEvent:Connect(function(player)
		local success, result = DataManager.BuyNextLauncher(player)
		if not success then notify(player, result, "error") return end
		launcherReady[player] = launcherReady[player] or {}
		launcherReady[player][result] = 0
		PlotManager.CreateLauncher(player, result)
		sendRocketState(player)
		notify(player, string.format("Установка %d построена", result), "success")
	end)

	launchEvent.OnServerEvent:Connect(function(player, targetPlotId, targetSlotIndex)
		local now = os.clock()
		if now - (lastRequest[player] or 0) &lt; 0.2 then return end
		lastRequest[player] = now
		if type(targetPlotId) ~= "number" or type(targetSlotIndex) ~= "number" then return end
		if targetPlotId % 1 ~= 0 or targetSlotIndex % 1 ~= 0 or targetSlotIndex &lt; 1 or targetSlotIndex &gt; #Config.FARM_TYPES then return end

		local targetPlot = PlotManager.GetPlot(targetPlotId)
		local myPlotId = select(1, PlotManager.GetPlotByPlayer(player))
		if not targetPlot or not targetPlot.owner or myPlotId == targetPlotId then return end
		if not FarmManager.IsSlotAlive(targetPlotId, targetSlotIndex) then
			notify(player, "Эта цель недоступна", "error")
			return
		end

		local launcherIndex = takeReadyLauncher(player)
		if not launcherIndex then
			notify(player, "Все ракеты перезаряжаются", "error")
			return
		end
		local originPos = PlotManager.GetLauncherOrigin(player, launcherIndex)
		if not originPos then return end
		local targetPos = FarmManager.GetSlotTargetPosition(targetPlotId, targetSlotIndex)
		local destroyed = FarmManager.DamageAtSlot(targetPlotId, targetSlotIndex, Config.ROCKET_DAMAGE)

		firedEvent:FireAllClients({
			shooterName = player.DisplayName,
			originPos = originPos,
			targetPos = targetPos,
			targetPlotId = targetPlotId,
			targetSlotIndex = targetSlotIndex,
			destroyed = destroyed,
		})
	end)
end

return RocketManager</string>
        </Properties>
      </Item>
    </Item>
  </Item>
