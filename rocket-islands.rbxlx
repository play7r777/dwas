      <Item class="LocalScript" referent="16">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- init.client.luau - Rojo client entry point
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes    = require(sharedFolder:WaitForChild("Remotes"))
local HudManager = require(script:WaitForChild("HudManager"))
local RocketAnim = require(script:WaitForChild("RocketAnim"))
local VisualFX   = require(script:WaitForChild("VisualFX"))

-- Получение настроек анимации
local getAnimFn = Remotes.Get("GetAnimSetting")
local animEnabled = true
pcall(function()
	animEnabled = getAnimFn:InvokeServer()
end)

-- Инициализация HUD
HudManager.Init(animEnabled)

-- Слушатели сетевых событий
local rocketFired = Remotes.Get("RocketFired")
rocketFired.OnClientEvent:Connect(function(data)
	RocketAnim.Play(data, HudManager.IsAnimEnabled())
end)

local updateData = Remotes.Get("UpdateData")
updateData.OnClientEvent:Connect(function(data)
	HudManager.UpdateData(data)
end)

local rocketState = Remotes.Get("RocketStateChanged")
rocketState.OnClientEvent:Connect(function(data)
	HudManager.UpdateRocketState(data)
end)

local notify = Remotes.Get("Notify")
notify.OnClientEvent:Connect(function(message, kind)
	local colors = {
		success = Color3.fromRGB(98, 220, 144),
		error = Color3.fromRGB(239, 117, 91),
		info = Color3.fromRGB(235, 239, 241),
	}
	HudManager.ShowNotification(message, colors[kind] or colors.info)
end)

local spawnIncomeFX = Remotes.Get("SpawnIncomeFX")
spawnIncomeFX.OnClientEvent:Connect(function(pos, amount)
	VisualFX.SpawnIncome(pos, amount)
end)

print("[Client] Rocket Islands client connected")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">HudManager</string>
            <string name="Source">-- HudManager.luau - compact economy, launcher status, and target controls
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes           = require(sharedFolder:WaitForChild("Remotes"))
local Config            = require(sharedFolder:WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local HudManager = {}

local animEnabled = true
local moneyLabel, rocketLabel, buyRocketBtn
local launcherCount = Config.START_LAUNCHERS
local rocketReady = Config.START_LAUNCHERS
local targetListFrame
local notifFrame, notifLabel, notifThread

local function makeFrame(parent, size, pos, color, alpha, name)
	local f = Instance.new("Frame")
	f.Name = name or "Frame"
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or Color3.fromRGB(25, 25, 35)
	f.BackgroundTransparency = alpha or 0.15
	f.BorderSizePixel = 0
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = f
	return f
end

local function makeLabel(parent, text, size, pos, color, fontSize, font)
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	l.TextSize = fontSize or 15
	l.Font = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function makeButton(parent, text, size, pos, bgColor, textColor)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = bgColor or Color3.fromRGB(50, 120, 220)
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
	b.TextSize = 14
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	b.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = b
	return b
end

function HudManager.ShowNotification(text, color)
	if notifLabel and notifFrame then
		notifLabel.Text = text
		notifLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
		notifFrame.Visible = true
		if notifThread then task.cancel(notifThread) end
		notifThread = task.delay(4.5, function()
			if notifFrame then notifFrame.Visible = false end
		end)
	end
end

local function getPlotForUser(userId)
	for _, folder in ipairs(workspace:GetChildren()) do
		if folder:GetAttribute("OwnerUserId") == userId then
			return folder, folder:GetAttribute("PlotId")
		end
	end
	return nil, nil
end

local function refreshTargets()
	if not targetListFrame then return end
	for _, child in ipairs(targetListFrame:GetChildren()) do
		if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
	end

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer == player then continue end
		local targetPlotFolder, targetPlotId = getPlotForUser(targetPlayer.UserId)
		if not targetPlotFolder or not targetPlotId then continue end

		local activeSlots = {}
		for slotIndex = 1, #Config.FARM_TYPES do
			local territory = targetPlotFolder:FindFirstChild("Territory_" .. slotIndex)
			local farmFolder = territory and territory:FindFirstChild("FarmSlot_" .. slotIndex)
			if farmFolder and farmFolder:GetAttribute("Alive") ~= false then
				table.insert(activeSlots, slotIndex)
			end
		end
		if #activeSlots == 0 then continue end

		local card = makeFrame(targetListFrame, UDim2.new(1, -8, 0, 32 + #activeSlots * 30), UDim2.new(), Color3.fromRGB(35, 42, 47), 0.08, targetPlayer.Name)
		makeLabel(card, targetPlayer.DisplayName, UDim2.new(1, -12, 0, 26), UDim2.fromOffset(7, 2), Color3.fromRGB(235, 239, 241), 14, Enum.Font.GothamBold)
		for rowIndex, slotIndex in ipairs(activeSlots) do
			local farmConfig = Config.FARM_TYPES[slotIndex]
			local row = makeFrame(card, UDim2.new(1, -12, 0, 25), UDim2.fromOffset(6, 28 + (rowIndex - 1) * 30), Color3.fromRGB(48, 57, 62), 0, "Target_" .. slotIndex)
			makeLabel(row, farmConfig.name, UDim2.new(1, -70, 1, 0), UDim2.fromOffset(6, 0), farmConfig.color, 11)
			local attack = makeButton(row, "Огонь", UDim2.fromOffset(58, 21), UDim2.new(1, -62, 0, 2), Color3.fromRGB(205, 67, 55))
			attack.TextSize = 11
			attack.MouseButton1Click:Connect(function()
				Remotes.Get("LaunchRocket"):FireServer(targetPlotId, slotIndex)
			end)
		end
	end
end

local function setup3DClickTargeting()
	local mouse = player:GetMouse()
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local targetPart = mouse.Target
			if not targetPart then return end

			local ancestorFolder = targetPart:FindFirstAncestor("FarmSlot_%d+") or targetPart.Parent
			if ancestorFolder and ancestorFolder.Name:match("^FarmSlot_") and ancestorFolder:GetAttribute("Alive") ~= false then
				local slotIndex = tonumber(ancestorFolder.Name:match("%d+"))
				-- Ищем папку территории или плота
				local territoryFolder = ancestorFolder.Parent
				local plotFolder = territoryFolder and territoryFolder.Parent
				local targetPlotId = plotFolder and plotFolder:GetAttribute("PlotId")
				local ownerUserId = plotFolder and plotFolder:GetAttribute("OwnerUserId")
				if targetPlotId and ownerUserId and ownerUserId ~= 0 and ownerUserId ~= player.UserId and slotIndex then
					Remotes.Get("LaunchRocket"):FireServer(targetPlotId, slotIndex)
				end
			end
		end
	end)
end

function HudManager.Init(initAnimEnabled)
	animEnabled = initAnimEnabled ~= false

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "TycoonHud"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	screenGui.Parent = playerGui

	notifFrame = makeFrame(screenGui, UDim2.new(0, 360, 0, 50), UDim2.new(0.5, -180, 0, 10), Color3.fromRGB(20, 20, 25), 0.1, "NotifFrame")
	notifFrame.ZIndex = 20
	notifFrame.Visible = false

	notifLabel = makeLabel(notifFrame, "", UDim2.new(1, -10, 1, 0), UDim2.new(0, 5, 0, 0), Color3.fromRGB(255, 255, 255), 14, Enum.Font.GothamBold)
	notifLabel.TextXAlignment = Enum.TextXAlignment.Center

	local resPanel = makeFrame(screenGui, UDim2.new(0, 230, 0, 105), UDim2.new(0, 12, 0, 12), Color3.fromRGB(20, 20, 30), 0.1, "ResPanel")

	makeLabel(resPanel, "ROCKET ISLANDS", UDim2.new(1, -10, 0, 24), UDim2.new(0, 8, 0, 4), Color3.fromRGB(92, 205, 188), 16, Enum.Font.GothamBold)

	moneyLabel = makeLabel(resPanel, "Деньги  $0", UDim2.new(1, -10, 0, 22), UDim2.new(0, 8, 0, 32), Color3.fromRGB(255, 214, 90), 15)
	rocketLabel = makeLabel(resPanel, "Готово  1 / 1", UDim2.new(1, -10, 0, 22), UDim2.new(0, 8, 0, 56), Color3.fromRGB(98, 220, 144), 15)

	local actPanel = makeFrame(screenGui, UDim2.new(0, 230, 0, 55), UDim2.new(0, 12, 0, 125), Color3.fromRGB(20, 20, 30), 0.1, "ActPanel")

	buyRocketBtn = makeButton(actPanel, "Установка 2  $" .. Config.LAUNCHER_COSTS[2], UDim2.new(1, -16, 0, 38), UDim2.new(0, 8, 0, 8), Color3.fromRGB(33, 133, 151))
	buyRocketBtn.MouseButton1Click:Connect(function()
		Remotes.Get("BuyLauncher"):FireServer()
	end)

	local targetPanel = makeFrame(screenGui, UDim2.new(0, 260, 0, 380), UDim2.new(1, -272, 0, 12), Color3.fromRGB(20, 20, 30), 0.1, "TargetPanel")

	makeLabel(targetPanel, "ЦЕЛИ", UDim2.new(1, -10, 0, 26), UDim2.new(0, 8, 0, 4), Color3.fromRGB(236, 108, 91), 16, Enum.Font.GothamBold)

	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Size = UDim2.new(1, -10, 1, -36)
	scrollFrame.Position = UDim2.new(0, 5, 0, 32)
	scrollFrame.BackgroundTransparency = 1
	scrollFrame.BorderSizePixel = 0
	scrollFrame.ScrollBarThickness = 5
	scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrollFrame.Parent = targetPanel

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = scrollFrame

	targetListFrame = scrollFrame

	setup3DClickTargeting()

	Players.PlayerAdded:Connect(function() task.wait(1) refreshTargets() end)
	Players.PlayerRemoving:Connect(function() task.wait(1) refreshTargets() end)
	
	-- Слушаем изменения зданий для обновления списка целей
	local buildingState = Remotes.Get("BuildingStateChanged")
	buildingState.OnClientEvent:Connect(function()
		task.wait(0.5)
		refreshTargets()
	end)
	
	task.delay(1.5, refreshTargets)
	
	-- Регулярное обновление UI целей на случай если кто-то построился
	task.spawn(function()
		while true do
			task.wait(5)
			refreshTargets()
		end
	end)
end

function HudManager.UpdateData(data)
	if moneyLabel then moneyLabel.Text = "Деньги  $" .. (data.money or 0) end
	launcherCount = data.launchers or launcherCount
	if buyRocketBtn then
		if launcherCount &gt;= Config.MAX_LAUNCHERS then
			buyRocketBtn.Text = "Все установки построены"
			buyRocketBtn.Active = false
			buyRocketBtn.BackgroundColor3 = Color3.fromRGB(73, 82, 86)
		else
			local nextCount = launcherCount + 1
			buyRocketBtn.Text = string.format("Установка %d  $%d", nextCount, Config.LAUNCHER_COSTS[nextCount])
			buyRocketBtn.Active = true
			buyRocketBtn.BackgroundColor3 = Color3.fromRGB(33, 133, 151)
		end
	end
end

function HudManager.UpdateRocketState(data)
	launcherCount = data.launchers or launcherCount
	rocketReady = data.ready or 0
	if rocketLabel then
		rocketLabel.Text = string.format("Готово  %d / %d", rocketReady, launcherCount)
		rocketLabel.TextColor3 = rocketReady &gt; 0 and Color3.fromRGB(98, 220, 144) or Color3.fromRGB(239, 117, 91)
	end
end

function HudManager.IsAnimEnabled()
	return animEnabled
end

return HudManager</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">RocketAnim</string>
            <string name="Source">-- RocketAnim.luau - arcing missile and impact effects
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local Debris            = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config            = require(sharedFolder:WaitForChild("Config"))

local RocketAnim = {}

local function spawnExplosion(pos)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(2, 2, 2)
	ball.Position = pos
	ball.Anchored = true
	ball.CanCollide = false
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 140, 20)
	ball.Parent = workspace

	local ballTween = TweenService:Create(ball,
		TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(22, 22, 22), Transparency = 1 })
	ballTween:Play()
	Debris:AddItem(ball, 0.5)

	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.6, 2, 2)
	ring.Position = pos
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 60, 20)
	ring.Orientation = Vector3.new(0, 0, 90)
	ring.Parent = workspace

	local ringTween = TweenService:Create(ring,
		TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.6, 30, 30), Transparency = 1 })
	ringTween:Play()
	Debris:AddItem(ring, 0.6)

	for i = 1, 8 do
		task.spawn(function()
			local smoke = Instance.new("Part")
			smoke.Shape = Enum.PartType.Ball
			smoke.Size = Vector3.new(3, 3, 3)
			smoke.Position = pos + Vector3.new(
				(math.random() - 0.5) * 10,
				math.random() * 6,
				(math.random() - 0.5) * 10
			)
			smoke.Anchored = true
			smoke.CanCollide = false
			smoke.Material = Enum.Material.SmoothPlastic
			smoke.Color = Color3.fromRGB(60 + math.random(30), 60 + math.random(30), 65)
			smoke.Parent = workspace

			local st = TweenService:Create(smoke,
				TweenInfo.new(0.9, Enum.EasingStyle.Quad),
				{ Size = Vector3.new(9, 9, 9), Transparency = 1, Position = smoke.Position + Vector3.new(0, 10, 0) })
			st:Play()
			Debris:AddItem(smoke, 1)
		end)
	end
end

local function arcPos(origin, target, t)
	local arc = Config.ROCKET_ARC
	local straight = origin:Lerp(target, t)
	local height = math.sin(t * math.pi) * arc
	return Vector3.new(straight.X, straight.Y + height, straight.Z)
end

function RocketAnim.Play(data, animEnabled)
	local origin = data.originPos
	local target = data.targetPos

	if not animEnabled then
		spawnExplosion(target)
		return
	end

	local rocket = Instance.new("Part")
	rocket.Name = "Rocket"
	rocket.Size = Vector3.new(1.5, 1.5, 5)
	rocket.Position = origin
	rocket.Anchored = true
	rocket.CanCollide = false
	rocket.Material = Enum.Material.Metal
	rocket.Color = Color3.fromRGB(225, 230, 232)
	rocket.Parent = workspace

	local front = Instance.new("Attachment")
	front.Position = Vector3.new(0, 0, -2)
	front.Parent = rocket
	local back = Instance.new("Attachment")
	back.Position = Vector3.new(0, 0, 2.5)
	back.Parent = rocket
	local trail = Instance.new("Trail")
	trail.Attachment0 = front
	trail.Attachment1 = back
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 205, 70), Color3.fromRGB(235, 75, 35))
	trail.Lifetime = 0.3
	trail.MinLength = 0.4
	trail.Parent = rocket

	local light = Instance.new("PointLight")
	light.Brightness = 8
	light.Range = 20
	light.Color = Color3.fromRGB(255, 120, 20)
	light.Parent = rocket

	local skipped = false
	local skipConn
	skipConn = UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			skipped = true
		end
	end)

	local dist = (target - origin).Magnitude
	local duration = math.clamp(dist / Config.ROCKET_SPEED, 0.8, Config.ROCKET_ANIM_TIME)
	local steps = math.ceil(duration / 0.03)

	for i = 1, steps do
		if skipped then break end
		local t = i / steps
		local pos = arcPos(origin, target, t)

		local nextT = math.min(t + 0.04, 1)
		local nextPos = arcPos(origin, target, nextT)
		local dir = (nextPos - pos)
		if dir.Magnitude &gt; 0.001 then
			rocket.CFrame = CFrame.lookAt(pos, pos + dir)
		end

		task.wait(0.03)
	end

	skipConn:Disconnect()
	rocket:Destroy()

	spawnExplosion(target)

	local msg
	if data.destroyed then
		msg = string.format("%s уничтожил цель #%d", data.shooterName, data.targetSlotIndex or 1)
	else
		msg = string.format("%s атаковал остров %d", data.shooterName, data.targetPlotId or 1)
	end

	local ok, HudManager = pcall(require, script.Parent:WaitForChild("HudManager"))
	if ok and HudManager then
		HudManager.ShowNotification(msg, data.destroyed and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 180, 40))
	end
end

return RocketAnim</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">VisualFX</string>
            <string name="Source"><![CDATA[-- VisualFX.luau — Визуальные 3D эффекты: всплывающие деньги +$Cash над зданиями
local TweenService = game:GetService("TweenService")
local Debris       = game:GetService("Debris")

local VisualFX = {}

function VisualFX.SpawnIncome(pos, amount)
	local part = Instance.new("Part")
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Position = pos
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Parent = workspace

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 120, 0, 40)
	bb.StudsOffset = Vector3.new(0, 0, 0)
	bb.AlwaysOnTop = true
	bb.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "+$" .. amount
	label.TextColor3 = Color3.fromRGB(60, 255, 100)
	label.TextStrokeColor3 = Color3.fromRGB(0, 50, 0)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.Parent = bb

	-- Анимация взлета вверх и растворения
	local tweenInfo = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local moveTween = TweenService:Create(part, tweenInfo, { Position = pos + Vector3.new(0, 8, 0) })
	local fadeTween = TweenService:Create(label, tweenInfo, { TextTransparency = 1, TextStrokeTransparency = 1 })

	moveTween:Play()
	fadeTween:Play()

	Debris:AddItem(part, 1.5)
end

return VisualFX
]]></string>
          </Properties>
        </Item>
