    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- init.server.luau — Точка входа сервера для Rojo
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes       = require(sharedFolder:WaitForChild("Remotes"))
local DataManager   = require(script:WaitForChild("DataManager"))
local PlotManager   = require(script:WaitForChild("PlotManager"))
local FarmManager   = require(script:WaitForChild("FarmManager"))
local RocketManager = require(script:WaitForChild("RocketManager"))

-- 1. Инициализация сетевых событий
Remotes.Init()

-- 2. Инициализация менеджеров
DataManager.Init()
PlotManager.Init()
FarmManager.Init()
RocketManager.Init()

print("==================================================")
print("[Server] Tycoon Rocket Battle запущен через Rojo!")
print("==================================================")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- DataManager.luau - persistent money, launcher count, rocket levels, and player preferences
local Players          = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder     = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes          = require(sharedFolder:WaitForChild("Remotes"))
local Config           = require(sharedFolder:WaitForChild("Config"))

local DataManager = {}

local playerData = {}

local moneyStore = DataStoreService:GetDataStore("TycoonMoney_v3")
local animStore  = DataStoreService:GetDataStore("TycoonAnim_v3")

local function defaultData()
	return {
		money = Config.START_MONEY,
		launchers = Config.START_LAUNCHERS,
		rocketLevels = { 1 },
		animEnabled = true,
	}
end

local function load(player)
	local uid = tostring(player.UserId)
	local ok, saved = pcall(function()
		return moneyStore:GetAsync(uid)
	end)

	local data = defaultData()
	if ok and saved then
		data.money = tonumber(saved.money) or data.money
		-- Старые сейвы могли иметь до 6 установок — зажимаем в новый максимум (4).
		data.launchers = math.clamp(tonumber(saved.launchers) or Config.START_LAUNCHERS, Config.START_LAUNCHERS, Config.MAX_LAUNCHERS)
		local savedLevels = type(saved.rocketLevels) == "table" and saved.rocketLevels or {}
		data.rocketLevels = {}
		for index = 1, data.launchers do
			data.rocketLevels[index] = math.clamp(tonumber(savedLevels[index]) or 1, 1, Config.MAX_ROCKET_LEVEL)
		end
	end

	local ok2, animVal = pcall(function()
		return animStore:GetAsync(uid)
	end)
	if ok2 and animVal ~= nil then
		data.animEnabled = animVal
	end

	playerData[player] = data
end

local function save(player)
	local data = playerData[player]
	if not data then return end
	local uid = tostring(player.UserId)
	pcall(function()
		moneyStore:UpdateAsync(uid, function()
			return { money = data.money, launchers = data.launchers, rocketLevels = data.rocketLevels }
		end)
	end)
	pcall(function()
		animStore:SetAsync(uid, data.animEnabled)
	end)
end

function DataManager.Init()
	Players.PlayerAdded:Connect(function(player)
		load(player)
		task.delay(1, function()
			if player and player.Parent then
				DataManager.SendUpdate(player)
			end
		end)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		load(player)
		task.delay(1, function()
			if player and player.Parent then
				DataManager.SendUpdate(player)
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		playerData[player] = nil
	end)

	local setAnim = Remotes.Get("SetAnimSetting")
	setAnim.OnServerEvent:Connect(function(player, enabled)
		local data = playerData[player]
		if data then
			data.animEnabled = enabled == true
			pcall(function()
				animStore:SetAsync(tostring(player.UserId), data.animEnabled)
			end)
		end
	end)

	local getAnim = Remotes.Get("GetAnimSetting")
	getAnim.OnServerInvoke = function(player)
		local data = playerData[player]
		return data and data.animEnabled ~= false
	end
end

function DataManager.GetData(player)
	return playerData[player]
end

function DataManager.GetMoney(player)
	local data = playerData[player]
	return data and data.money or 0
end

function DataManager.AddMoney(player, amount)
	local data = playerData[player]
	if data then
		data.money = math.max(0, data.money + amount)
		DataManager.SendUpdate(player)
	end
end

function DataManager.GetLauncherCount(player)
	local data = playerData[player]
	return data and data.launchers or 0
end

-- Уровень прокачки конкретного стенда (0 — стенд ещё не куплен).
function DataManager.GetLauncherLevel(player, index)
	local data = playerData[player]
	if not data then return 0 end
	if index < 1 or index > data.launchers then return 0 end
	return data.rocketLevels[index] or 1
end

function DataManager.BuyNextLauncher(player)
	local data = playerData[player]
	if not data then return false, "Данные игрока загружаются" end
	if data.launchers >= Config.MAX_LAUNCHERS then
		return false, string.format("Все %d установки уже построены", Config.MAX_LAUNCHERS)
	end
	local nextCount = data.launchers + 1
	local cost = Config.LAUNCHER_COSTS[nextCount]
	if data.money < cost then return false, string.format("Нужно ещё $%d", cost - data.money) end
	data.money -= cost
	data.launchers = nextCount
	data.rocketLevels[nextCount] = 1
	DataManager.SendUpdate(player)
	return true, nextCount
end

-- Прокачка купленного стенда на +1 уровень. Возвращает (true, новыйУровень) либо (false, причина).
function DataManager.UpgradeLauncher(player, index)
	local data = playerData[player]
	if not data then return false, "Данные игрока загружаются" end
	if index < 1 or index > data.launchers then return false, "Сначала купите эту установку" end
	local level = data.rocketLevels[index] or 1
	if level >= Config.MAX_ROCKET_LEVEL then return false, "Максимальный уровень ракеты" end
	local cost = Config.RocketUpgradeCost(level + 1)
	if data.money < cost then return false, string.format("Нужно ещё $%d", cost - data.money) end
	data.money -= cost
	data.rocketLevels[index] = level + 1
	DataManager.SendUpdate(player)
	return true, level + 1
end

function DataManager.SendUpdate(player)
	local data = playerData[player]
	if not data then return end
	local ev = Remotes.Get("UpdateData")
	ev:FireClient(player, {
		money = data.money,
		launchers = data.launchers,
		rocketLevels = data.rocketLevels,
		animEnabled = data.animEnabled,
	})
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">FarmManager</string>
          <string name="Source"><![CDATA[-- FarmManager.luau — Строительство зданий, логика доходов, получение урона и КД восстановления
--
-- v3: здания мини-городка полностью переработаны. Дом растёт ВВЕРХ с прокачкой
-- (уровень = количество этажей), у каждого тира свой архитектурный стиль, вокруг
-- дома — дорожка, фонари и кусты ("мини-городок" на каждой площадке).
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config            = require(sharedFolder:WaitForChild("Config"))
local Remotes           = require(sharedFolder:WaitForChild("Remotes"))
local DataManager       = require(script.Parent:WaitForChild("DataManager"))
local PlotManager       = require(script.Parent:WaitForChild("PlotManager"))

local FarmManager = {}

-- plotFarms[plotId][slotIndex] = { tier, level, hp, maxHp, alive, rebuildTimer, folder, body, hpBar, statusLabel }
local plotFarms = {}

local function makeDecorPart(parent, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function makeDecorCylinder(parent, name, height, diameter, position, color, material)
	local part = makeDecorPart(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Генерация кусочка суши, моста и мини-городка при покупке слота
local function buildTerritory(plotId, slotIndex)
	local plot = PlotManager.GetPlot(plotId)
	local slotInfo = plot.slots[slotIndex]
	local center = slotInfo.center
	local edgePos = slotInfo.edgePos

	local territoryFolder = Instance.new("Folder")
	territoryFolder.Name = "Territory_" .. slotIndex
	territoryFolder.Parent = plot.folder

	local dist = (center - edgePos).Magnitude
	local shoreY = plot.center.Y + 10
	local bridgeStart = Vector3.new(edgePos.X, shoreY, edgePos.Z)
	local bridgeEnd = Vector3.new(center.X, shoreY, center.Z)

	local bridge = Instance.new("Part")
	bridge.Name = "Bridge"
	bridge.Anchored = true
	bridge.Size = Vector3.new(7, 1.2, dist)
	bridge.CFrame = CFrame.lookAt(bridgeStart, bridgeEnd) * CFrame.new(0, 0, -dist / 2)
	bridge.Color = Color3.fromRGB(115, 79, 43)
	bridge.Material = Enum.Material.WoodPlanks
	bridge.Parent = territoryFolder

	for supportIndex = 1, 3 do
		local fraction = supportIndex / 4
		local support = Instance.new("Part")
		support.Name = "BridgePost"
		support.Anchored = true
		support.Size = Vector3.new(1.2, 22, 1.2)
		support.Position = bridgeStart:Lerp(bridgeEnd, fraction) - Vector3.new(0, 11, 0)
		support.Color = Color3.fromRGB(73, 52, 34)
		support.Material = Enum.Material.Wood
		support.Parent = territoryFolder
	end

	local bottom = Instance.new("Part")
	bottom.Name = "RockBottom"
	bottom.Anchored = true
	bottom.Shape = Enum.PartType.Cylinder
	bottom.Size = Vector3.new(22, Config.SLOT_PLATFORM_SIZE * 0.9, Config.SLOT_PLATFORM_SIZE * 0.9)
	bottom.Orientation = Vector3.new(0, 0, 90)
	bottom.Position = center - Vector3.new(0, 2, 0)
	bottom.Color = Color3.fromRGB(81, 78, 69)
	bottom.Material = Enum.Material.Rock
	bottom.Parent = territoryFolder

	local top = Instance.new("Part")
	top.Name = "IslandTop"
	top.Anchored = true
	top.Shape = Enum.PartType.Cylinder
	top.Size = Vector3.new(7, Config.SLOT_PLATFORM_SIZE, Config.SLOT_PLATFORM_SIZE)
	top.Orientation = Vector3.new(0, 0, 90)
	top.Position = center + Vector3.new(0, 6, 0)
	top.Color = Color3.fromRGB(235, 211, 149)
	top.Material = Enum.Material.Sand
	top.Parent = territoryFolder

	-- === Мини-городок вокруг будущего дома: дорожка, фонари, кусты ===
	local up = Vector3.new(0, 1, 0)
	local toCenter = Vector3.new(plot.center.X - center.X, 0, plot.center.Z - center.Z)
	toCenter = toCenter.Magnitude > 0.001 and toCenter.Unit or Vector3.new(0, 0, -1)
	local side = toCenter:Cross(up)
	local sandTop = center.Y + 9.5 -- верх песчаного диска площадки
	local flatCenter = Vector3.new(center.X, sandTop, center.Z)

	-- Дорожка из плит от моста к крыльцу дома
	for i = 1, 3 do
		local r = Config.SLOT_PLATFORM_SIZE / 2 - 4 - (i - 1) * 6
		local tilePos = flatCenter + toCenter * r + Vector3.new(0, 0.15, 0)
		makeDecorPart(territoryFolder, "PathTile_" .. i, Vector3.new(3.6, 0.3, 4.4), CFrame.lookAt(tilePos, tilePos + toCenter), Color3.fromRGB(196, 186, 168), Enum.Material.Concrete)
	end

	-- Пара уличных фонарей у дорожки (тёплый свет вечером)
	for _, s in ipairs({ -1, 1 }) do
		local lampBase = flatCenter + toCenter * 19 + side * (s * 6)
		makeDecorCylinder(territoryFolder, "LampPole", 5.4, 0.5, lampBase + Vector3.new(0, 2.7, 0), Color3.fromRGB(52, 56, 62), Enum.Material.Metal)
		local bulb = makeDecorPart(territoryFolder, "LampBulb", Vector3.new(1.1, 1.1, 1.1), CFrame.new(lampBase + Vector3.new(0, 5.7, 0)), Color3.fromRGB(255, 214, 120), Enum.Material.Neon)
		bulb.Shape = Enum.PartType.Ball
		bulb.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 208, 120)
		light.Brightness = 0.9
		light.Range = 15
		light.Parent = bulb
	end

	-- Кусты вокруг дома (не залезают в стены: отступ от полуширины дома тира)
	local tier = slotIndex
	local halfWidth = (16 + tier * 2) / 2
	local bushOffsets = {
		side * (halfWidth + 2.5) + toCenter * 2,
		side * -(halfWidth + 2.5) + toCenter * 2,
		toCenter * -(halfWidth + 5) + side * 5,
	}
	for i, off in ipairs(bushOffsets) do
		local bush = makeDecorPart(territoryFolder, "Bush_" .. i, Vector3.new(3, 2.4, 3), CFrame.new(flatCenter + off + Vector3.new(0, 1, 0)), Color3.fromRGB(78, 152, 88), Enum.Material.Grass)
		bush.Shape = Enum.PartType.Ball
		bush.CanCollide = false
	end

	return territoryFolder
end

-- Архитектурные стили пяти тиров зданий мини-городка.
local TIER_STYLES = {
	[1] = { -- пляжный дом: дерево и терракотовая крыша
		wall = Color3.fromRGB(226, 202, 160), wallMat = Enum.Material.WoodPlanks,
		trim = Color3.fromRGB(140, 100, 62), roof = Color3.fromRGB(186, 88, 56), roofStyle = "gable",
		glass = Color3.fromRGB(150, 214, 232), glassMat = Enum.Material.Glass,
	},
	[2] = { -- прибрежный коттедж: пастельные стены, серо-синяя крыша
		wall = Color3.fromRGB(216, 236, 229), wallMat = Enum.Material.SmoothPlastic,
		trim = Color3.fromRGB(74, 112, 122), roof = Color3.fromRGB(62, 112, 128), roofStyle = "gable",
		glass = Color3.fromRGB(140, 210, 230), glassMat = Enum.Material.Glass,
	},
	[3] = { -- белая вилла: плоская крыша с садом
		wall = Color3.fromRGB(246, 246, 240), wallMat = Enum.Material.SmoothPlastic,
		trim = Color3.fromRGB(190, 194, 198), roof = Color3.fromRGB(232, 234, 238), roofStyle = "flat",
		glass = Color3.fromRGB(110, 205, 235), glassMat = Enum.Material.Glass,
	},
	[4] = { -- модерновый особняк: тёмный корпус, янтарное остекление, маяк
		wall = Color3.fromRGB(54, 60, 68), wallMat = Enum.Material.SmoothPlastic,
		trim = Color3.fromRGB(120, 126, 134), roof = Color3.fromRGB(44, 48, 54), roofStyle = "flat",
		glass = Color3.fromRGB(255, 152, 48), glassMat = Enum.Material.Neon, beacon = true,
	},
	[5] = { -- резиденция: башня с вертолётной площадкой и неоном
		wall = Color3.fromRGB(236, 240, 246), wallMat = Enum.Material.SmoothPlastic,
		trim = Color3.fromRGB(214, 178, 96), roof = Color3.fromRGB(226, 230, 238), roofStyle = "helipad",
		glass = Color3.fromRGB(242, 92, 190), glassMat = Enum.Material.Neon,
	},
}

-- Уникальные 3D модели зданий. Уровень прокачки = количество этажей: дом растёт
-- вверх с каждым уровнем. baseCF ставит дом фасадом (входом) к центру острова.
local function buildBuildingModel(plotId, slotIndex, tier, level, territoryFolder)
	local plot = PlotManager.GetPlot(plotId)
	local slotCenter = plot.slots[slotIndex].center + Vector3.new(0, 10, 0)
	-- Дверь/фасад дома смотрит по локальной -Z; направляем -Z на центр острова (к мосту).
	local baseCF = CFrame.lookAt(slotCenter, Vector3.new(plot.center.X, slotCenter.Y, plot.center.Z))

	local style = TIER_STYLES[tier]
	local home = Instance.new("Model")
	home.Name = "IncomeHome_" .. slotIndex
	home:SetAttribute("Alive", true)
	home.Parent = territoryFolder

	local width = 16 + tier * 2
	local depth = 14 + tier * 2
	local storeyH = 4.6
	local floors = math.clamp(level, 1, Config.MAX_BUILDING_LEVEL)

	-- lp — все смещения ЛОКАЛЬНЫЕ относительно пола дома (baseCF), пол на локальном y=0.
	local function lp(name, size, dx, dy, dz, color, material, angles)
		local cf = baseCF * CFrame.new(dx, dy, dz)
		if angles then cf = cf * angles end
		local instance = Instance.new("Part")
		instance.Name = name
		instance.Anchored = true
		instance.Size = size
		instance.CFrame = cf
		instance.Color = color
		instance.Material = material
		instance.TopSurface = Enum.SurfaceType.Smooth
		instance.BottomSurface = Enum.SurfaceType.Smooth
		instance.Parent = home
		return instance
	end

	-- Каменное основание (чуть шире дома, слегка утоплено в песок)
	lp("Foundation", Vector3.new(width + 2, 1.2, depth + 2), 0, 0, 0, Color3.fromRGB(168, 162, 152), Enum.Material.Concrete)

	-- Этажи: четыре стены + ленточное остекление на каждом этаже.
	for f = 1, floors do
		local y0 = 0.6 + (f - 1) * storeyH -- низ этажа
		local wallY = y0 + storeyH / 2
		local bandY = y0 + storeyH * 0.62

		lp("Wall_B" .. f, Vector3.new(width, storeyH, 1), 0, wallY, depth / 2, style.wall, style.wallMat)
		lp("Wall_L" .. f, Vector3.new(1, storeyH, depth), -width / 2, wallY, 0, style.wall, style.wallMat)
		lp("Wall_R" .. f, Vector3.new(1, storeyH, depth), width / 2, wallY, 0, style.wall, style.wallMat)

		local sideW = (width - 5) / 2
		if f == 1 then
			-- Фасад первого этажа со сквозным дверным проёмом
			lp("Wall_FL", Vector3.new(sideW, storeyH, 1), -(5 + sideW) / 2, wallY, -depth / 2, style.wall, style.wallMat)
			lp("Wall_FR", Vector3.new(sideW, storeyH, 1), (5 + sideW) / 2, wallY, -depth / 2, style.wall, style.wallMat)
			lp("DoorHeader", Vector3.new(5, storeyH - 3.4, 1), 0, y0 + storeyH - (storeyH - 3.4) / 2, -depth / 2, style.trim, Enum.Material.Wood)
		else
			lp("Wall_F" .. f, Vector3.new(width, storeyH, 1), 0, wallY, -depth / 2, style.wall, style.wallMat)
		end

		-- Ленточное остекление: полосы чуть отстоят от стен (нет копланарных граней)
		if f == 1 then
			lp("Band_FL" .. f, Vector3.new(sideW * 0.7, 1.5, 0.3), -(5 + sideW) / 2, bandY, -depth / 2 - 0.68, style.glass, style.glassMat)
			lp("Band_FR" .. f, Vector3.new(sideW * 0.7, 1.5, 0.3), (5 + sideW) / 2, bandY, -depth / 2 - 0.68, style.glass, style.glassMat)
		else
			lp("Band_F" .. f, Vector3.new(width * 0.8, 1.5, 0.3), 0, bandY, -depth / 2 - 0.68, style.glass, style.glassMat)
		end
		lp("Band_B" .. f, Vector3.new(width * 0.8, 1.5, 0.3), 0, bandY, depth / 2 + 0.68, style.glass, style.glassMat)
		lp("Band_L" .. f, Vector3.new(0.3, 1.5, depth * 0.8), -width / 2 - 0.68, bandY, 0, style.glass, style.glassMat)
		lp("Band_R" .. f, Vector3.new(0.3, 1.5, depth * 0.8), width / 2 + 0.68, bandY, 0, style.glass, style.glassMat)

		-- Межэтажный карниз
		if f < floors then
			lp("Slab" .. f, Vector3.new(width + 0.8, 0.35, depth + 0.8), 0, y0 + storeyH, 0, style.trim, Enum.Material.SmoothPlastic)
		end
	end

	local wallsTop = 0.6 + floors * storeyH

	-- Угловые пилястры на всю высоту — здание выглядит собранным, а не "коробкой"
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			lp("Pillar", Vector3.new(1.4, wallsTop, 1.4), sx * (width / 2), wallsTop / 2, sz * (depth / 2), style.trim, Enum.Material.SmoothPlastic)
		end
	end

	-- Крыльцо с навесом
	lp("Porch", Vector3.new(7, 0.7, 5), 0, 0.25, -depth / 2 - 2.5, Color3.fromRGB(128, 89, 50), Enum.Material.WoodPlanks)
	for _, x in ipairs({ -2.8, 2.8 }) do
		lp("PorchPost", Vector3.new(0.7, 4.6, 0.7), x, 3.1, -depth / 2 - 4.3, style.trim, Enum.Material.Wood)
	end
	lp("PorchRoof", Vector3.new(8, 0.6, 3.4), 0, 5.6, -depth / 2 - 3.2, style.roof, Enum.Material.Slate, CFrame.Angles(math.rad(8), 0, 0))

	-- Крыша по стилю тира
	local roofCore
	if style.roofStyle == "gable" then
		-- Двускатная крыша с КОНЬКОМ (пик /\): внутренние края скатов выше внешних.
		roofCore = lp("RoofLeft", Vector3.new(width / 2 + 1, 1, depth + 2), -width / 4, wallsTop + 1.4, 0, style.roof, Enum.Material.Slate, CFrame.Angles(0, 0, math.rad(24)))
		lp("RoofRight", Vector3.new(width / 2 + 1, 1, depth + 2), width / 4, wallsTop + 1.4, 0, style.roof, Enum.Material.Slate, CFrame.Angles(0, 0, math.rad(-24)))
		lp("Chimney", Vector3.new(2.2, 5.5, 2.2), width * 0.27, wallsTop + 3.4, 2, Color3.fromRGB(96, 84, 74), Enum.Material.Brick)
	else
		-- Плоская крыша с парапетом
		roofCore = lp("RoofSlab", Vector3.new(width + 1.4, 0.8, depth + 1.4), 0, wallsTop + 0.4, 0, style.roof, Enum.Material.SmoothPlastic)
		lp("ParapetF", Vector3.new(width + 1.4, 1.1, 0.5), 0, wallsTop + 1.3, -(depth + 0.9) / 2, style.trim, Enum.Material.SmoothPlastic)
		lp("ParapetB", Vector3.new(width + 1.4, 1.1, 0.5), 0, wallsTop + 1.3, (depth + 0.9) / 2, style.trim, Enum.Material.SmoothPlastic)
		lp("ParapetL", Vector3.new(0.5, 1.1, depth + 1.4), -(width + 0.9) / 2, wallsTop + 1.3, 0, style.trim, Enum.Material.SmoothPlastic)
		lp("ParapetR", Vector3.new(0.5, 1.1, depth + 1.4), (width + 0.9) / 2, wallsTop + 1.3, 0, style.trim, Enum.Material.SmoothPlastic)

		if style.roofStyle == "helipad" then
			local padD = math.min(width, depth) * 0.72
			local helipad = lp("Helipad", Vector3.new(0.35, padD, padD), 0, wallsTop + 1.0, 0, Color3.fromRGB(58, 62, 70), Enum.Material.SmoothPlastic, CFrame.Angles(0, 0, math.rad(90)))
			helipad.Shape = Enum.PartType.Cylinder
			local ring = lp("HelipadRing", Vector3.new(0.15, padD + 1.6, padD + 1.6), 0, wallsTop + 1.55, 0, style.glass, Enum.Material.Neon, CFrame.Angles(0, 0, math.rad(90)))
			ring.Shape = Enum.PartType.Cylinder
			ring.Transparency = 0.25
			ring.CanCollide = false
			lp("Spire", Vector3.new(0.6, 8, 0.6), -width * 0.32, wallsTop + 4.6, depth * 0.3, style.trim, Enum.Material.Metal)
			local orb = lp("SpireOrb", Vector3.new(1.4, 1.4, 1.4), -width * 0.32, wallsTop + 9, depth * 0.3, style.glass, Enum.Material.Neon)
			orb.Shape = Enum.PartType.Ball
			orb.CanCollide = false
		else
			-- Сад на плоской крыше
			for i, off in ipairs({ { -width * 0.25, -depth * 0.2 }, { width * 0.28, depth * 0.22 }, { -width * 0.1, depth * 0.28 } }) do
				local bush = lp("RoofBush_" .. i, Vector3.new(2.4, 2, 2.4), off[1], wallsTop + 1.9, off[2], Color3.fromRGB(74, 150, 84), Enum.Material.Grass)
				bush.Shape = Enum.PartType.Ball
				bush.CanCollide = false
			end
			if style.beacon then
				lp("Antenna", Vector3.new(0.4, 6, 0.4), width * 0.3, wallsTop + 3.8, depth * 0.25, Color3.fromRGB(200, 204, 210), Enum.Material.Metal)
				local beacon = lp("Beacon", Vector3.new(0.9, 0.9, 0.9), width * 0.3, wallsTop + 7, depth * 0.25, Color3.fromRGB(255, 70, 60), Enum.Material.Neon)
				beacon.Shape = Enum.PartType.Ball
				beacon.CanCollide = false
			end
		end
	end

	-- Статичной таблички «ур.N +$X» над зданием больше НЕТ (чистый экран):
	-- прибыль видно по всплывающим «+$» (VisualFX), уровень — по этажам дома.
	return home, roofCore, nil, nil
end

-- Обновляет ценник над кнопкой: покупка / прокачка до след. уровня / макс.
local function updatePriceTag(plotId, slotIndex)
	local plot = PlotManager.GetPlot(plotId)
	local slot = plot and plot.slots[slotIndex]
	if not slot or not slot.priceLabel then return end
	local base = Config.FARM_TYPES[slotIndex]
	local data = plotFarms[plotId] and plotFarms[plotId][slotIndex]

	if not data then
		slot.priceLabel.Text = string.format("%s\n$%d", base.name, base.cost)
		slot.priceLabel.TextColor3 = Color3.fromRGB(240, 244, 246)
	elseif data.level >= Config.MAX_BUILDING_LEVEL then
		slot.priceLabel.Text = string.format("%s (ур.%d)\nМакс. уровень", base.name, data.level)
		slot.priceLabel.TextColor3 = Color3.fromRGB(255, 224, 150)
	else
		local cost = Config.UpgradeCost(slotIndex, data.level + 1)
		slot.priceLabel.Text = string.format("Прокачка до ур.%d\n$%d", data.level + 1, cost)
		slot.priceLabel.TextColor3 = Color3.fromRGB(240, 244, 246)
	end
end

-- Прочность здания растёт с уровнем.
local function maxHpForLevel(tier, level)
	local base = Config.FARM_TYPES[tier]
	return math.floor(base.maxHp * (1 + 0.35 * (level - 1)))
end

local function spawnBuilding(plotId, slotIndex, level)
	if not plotFarms[plotId] then plotFarms[plotId] = {} end

	local oldData = plotFarms[plotId][slotIndex]
	if oldData and oldData.folder then
		oldData.folder:Destroy()
	end

	local plot = PlotManager.GetPlot(plotId)
	local tier = slotIndex -- слот N соответствует зданию тира N

	-- Если территории еще нет, строим её
	local territoryFolder = plot.folder:FindFirstChild("Territory_" .. slotIndex)
	if not territoryFolder then
		territoryFolder = buildTerritory(plotId, slotIndex)
	end

	local maxHp = maxHpForLevel(tier, level)
	local folder, body, hpBar, statusLabel = buildBuildingModel(plotId, slotIndex, tier, level, territoryFolder)

	-- Активация кнопки СЛЕДУЮЩЕГО слота (последовательное открытие)
	local nextSlot = slotIndex + 1
	if plot and plot.slots[nextSlot] and not (plotFarms[plotId] and plotFarms[plotId][nextSlot]) then
		plot.slots[nextSlot].buyPad.Transparency = 0
		plot.slots[nextSlot].buyPad.CanCollide = true
		if plot.slots[nextSlot].billboard then plot.slots[nextSlot].billboard:SetAttribute("Unlocked", true) end
	end

	plotFarms[plotId][slotIndex] = {
		tier = tier,
		level = level,
		hp = maxHp,
		maxHp = maxHp,
		alive = true,
		folder = folder,
		body = body,
		hpBar = hpBar,
		statusLabel = statusLabel,
		rebuildTimer = 0,
	}

	-- ВАЖНО: ценник обновляем ПОСЛЕ записи нового уровня. Раньше он вызывался ДО
	-- записи и показывал цену ПРОШЛОГО шага — «пишет $100, а списывается $160».
	updatePriceTag(plotId, slotIndex)

	Remotes.Get("BuildingStateChanged"):FireAllClients(plotId, slotIndex, {
		tier = tier,
		level = level,
		hp = maxHp,
		maxHp = maxHp,
		alive = true,
		rebuildTimer = 0,
	})
end

-- Наступание на кнопку: покупка (если пусто) или прокачка (если уже построено).
function FarmManager.BuyOrUpgrade(player, slotIndex)
	local plotId = select(1, PlotManager.GetPlotByPlayer(player))
	if not plotId then return end
	local base = Config.FARM_TYPES[slotIndex]
	if not base then return end
	if not plotFarms[plotId] then plotFarms[plotId] = {} end

	local data = plotFarms[plotId][slotIndex]
	if not data then
		-- ПОКУПКА (уровень 1). Слот N доступен, только если построен слот N-1.
		if slotIndex > 1 and not plotFarms[plotId][slotIndex - 1] then return end
		local money = DataManager.GetMoney(player)
		if money < base.cost then
			-- Красная вспышка счётчика на клиенте: денег не хватает.
			Remotes.Get("Notify"):FireClient(player, string.format("Нужно ещё $%d", base.cost - money), "error")
			return
		end
		DataManager.AddMoney(player, -base.cost)
		spawnBuilding(plotId, slotIndex, 1)
		print(string.format("[FarmManager] %s построил %s (ур.1)", player.Name, base.name))
	else
		-- ПРОКАЧКА до следующего уровня.
		if not data.alive then return end
		if data.level >= Config.MAX_BUILDING_LEVEL then return end
		local nextLevel = data.level + 1
		local cost = Config.UpgradeCost(slotIndex, nextLevel)
		local money = DataManager.GetMoney(player)
		if money < cost then
			Remotes.Get("Notify"):FireClient(player, string.format("Нужно ещё $%d", cost - money), "error")
			return
		end
		DataManager.AddMoney(player, -cost)
		spawnBuilding(plotId, slotIndex, nextLevel)
		print(string.format("[FarmManager] %s прокачал %s до ур.%d", player.Name, base.name, nextLevel))
	end
end

-- Совместимость со старым именем/ремоутом.
function FarmManager.BuySlot(player, slotIndex)
	FarmManager.BuyOrUpgrade(player, slotIndex)
end

local function destroyBuilding(plotId, slotIndex)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	if not slotData or not slotData.alive then return end

	slotData.alive = false
	if slotData.folder then slotData.folder:SetAttribute("Alive", false) end
	local farmConfig = Config.FARM_TYPES[slotData.tier]
	local cd = farmConfig.cooldown

	if slotData.folder then
		for _, part in ipairs(slotData.folder:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Color = Color3.fromRGB(60, 60, 65)
				part.Material = Enum.Material.Concrete
			end
		end
	end

	if slotData.hpBar then slotData.hpBar.Size = UDim2.new(0, 0, 1, 0) end

	task.spawn(function()
		for timeLeft = cd, 1, -1 do
			if not slotData or slotData.alive then break end
			slotData.rebuildTimer = timeLeft
			if slotData.statusLabel then
				slotData.statusLabel.Text = string.format("Ремонт %dс", timeLeft)
				slotData.statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			end

			Remotes.Get("BuildingStateChanged"):FireAllClients(plotId, slotIndex, {
				tier = slotData.tier,
				hp = 0,
				maxHp = slotData.maxHp,
				alive = false,
				rebuildTimer = timeLeft,
			})
			task.wait(1)
		end

		local plot = PlotManager.GetPlot(plotId)
		if plot and plot.owner then
			spawnBuilding(plotId, slotIndex, slotData.level or 1)
			print(string.format("[FarmManager] Остров #%d Слот #%d заново восстановлен!", plotId, slotIndex))
		end
	end)
end

-- Анти-двойное списание: после срабатывания кнопки игрок обязан СОЙТИ с неё
-- (отойти от центра дальше радиуса), прежде чем она сработает снова. Раньше,
-- стоя на кнопке, Touched стрелял повторно каждую секунду — списывалось больше,
-- чем показывал ценник (баг «стоит 410, списалось ~700»).
local padLock = {} -- [key] = { player, pos, radius }

task.spawn(function()
	while true do
		task.wait(0.25)
		for key, rec in pairs(padLock) do
			local char = rec.player and rec.player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not rec.player.Parent or not hrp then
				padLock[key] = nil
			else
				local flat = Vector3.new(hrp.Position.X - rec.pos.X, 0, hrp.Position.Z - rec.pos.Z)
				if flat.Magnitude > rec.radius then
					padLock[key] = nil
				end
			end
		end
	end
end)

function FarmManager.Init()
	for plotId, plot in pairs(PlotManager.GetAllPlots()) do
		for slotIdx, slotInfo in ipairs(plot.slots) do
			-- Покупка/прокачка по НАСТУПАНИЮ на кнопку: ровно ОДИН раз за визит.
			slotInfo.buyPad.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if not player or plot.owner ~= player then return end
				local key = string.format("%d:%d:%d", player.UserId, plotId, slotIdx)
				if padLock[key] then return end
				padLock[key] = { player = player, pos = slotInfo.buyPad.Position, radius = 7 }
				FarmManager.BuyOrUpgrade(player, slotIdx)
			end)
		end
	end

	local buyEvent = Remotes.Get("BuyBuildingSlot")
	buyEvent.OnServerEvent:Connect(function(player, slotIndex)
		if type(slotIndex) == "number" then
			FarmManager.BuySlot(player, slotIndex)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.wait(1.5)
		local plotId = select(1, PlotManager.GetPlotByPlayer(player))
		if plotId then
			if not plotFarms[plotId] then plotFarms[plotId] = {} end

			-- Делаем кнопку первого слота видимой
			local plot = PlotManager.GetPlot(plotId)
			if plot and plot.slots[1] then
				plot.slots[1].buyPad.Transparency = 0
				plot.slots[1].buyPad.CanCollide = true
				if plot.slots[1].billboard then plot.slots[1].billboard:SetAttribute("Unlocked", true) end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local plotId = player:GetAttribute("PlotId") or select(1, PlotManager.GetPlotByPlayer(player))
		if plotId and plotFarms[plotId] then
			for _, slotData in pairs(plotFarms[plotId]) do
				if slotData.folder then slotData.folder:Destroy() end
			end
			plotFarms[plotId] = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.FARM_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				local plotId = select(1, PlotManager.GetPlotByPlayer(player))
				if plotId and plotFarms[plotId] then
					for slotIdx, slotData in pairs(plotFarms[plotId]) do
						local disabled = slotData and slotData.disabledUntil and workspace:GetServerTimeNow() < slotData.disabledUntil
						if slotData and slotData.alive and not disabled then
							local farmConfig = Config.FARM_TYPES[slotData.tier]
							if farmConfig then
								-- Доход растёт с уровнем здания.
								local income = Config.IncomeForLevel(slotData.tier, slotData.level or 1)
								DataManager.AddMoney(player, income)
								local plot = PlotManager.GetPlot(plotId)
								if plot and plot.slots[slotIdx] then
									Remotes.Get("SpawnIncomeFX"):FireClient(player, plot.slots[slotIdx].center + Vector3.new(0, 10, 0), income)
								end
							end
						end
					end
				end
			end
		end
	end)
end

function FarmManager.GetSlotTargetPosition(plotId, slotIndex)
	local plot = PlotManager.GetPlot(plotId)
	if not plot or not plot.slots[slotIndex] then
		return plot and plot.center or Vector3.zero
	end
	return plot.slots[slotIndex].center + Vector3.new(0, 6, 0)
end

function FarmManager.IsSlotAlive(plotId, slotIndex)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	return slotData ~= nil and slotData.alive == true
end

function FarmManager.DamageAtSlot(plotId, slotIndex, damage)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	if not slotData or not slotData.alive then return false end

	slotData.hp = math.max(0, slotData.hp - damage)
	if slotData.hpBar then
		slotData.hpBar.Size = UDim2.new(math.clamp(slotData.hp / slotData.maxHp, 0, 1), 0, 1, 0)
	end

	if slotData.hp <= 0 then
		destroyBuilding(plotId, slotIndex)
		return true
	end
	return false
end

-- Ракетный прилёт «оглушает» здание: доход отключается на duration секунд,
-- здание темнеет и дымит, пока не восстановится. disabledUntil — серверная метка.
function FarmManager.DisableSlot(plotId, slotIndex, duration)
	local slotData = plotFarms[plotId] and plotFarms[plotId][slotIndex]
	if not slotData or not slotData.alive then return end

	slotData.disabledUntil = workspace:GetServerTimeNow() + duration

	-- Затемняем части здания, запомнив исходные цвет/материал для восстановления.
	if slotData.folder and not slotData.disabledParts then
		slotData.disabledParts = {}
		for _, part in ipairs(slotData.folder:GetDescendants()) do
			if part:IsA("BasePart") then
				table.insert(slotData.disabledParts, { part = part, color = part.Color, material = part.Material })
				part.Color = Color3.fromRGB(72, 66, 60)
				part.Material = Enum.Material.Concrete
			end
		end
	end

	-- Дым над зданием как признак повреждения.
	if slotData.body and not slotData.smoke then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "DisabledSmoke"
		emitter.Texture = "rbxassetid://241594419"
		emitter.Color = ColorSequence.new(Color3.fromRGB(58, 58, 60))
		emitter.Size = NumberSequence.new(4, 9)
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(1.2, 2.2)
		emitter.Rate = 16
		emitter.Speed = NumberRange.new(4, 7)
		emitter.SpreadAngle = Vector2.new(22, 22)
		emitter.Acceleration = Vector3.new(0, 6, 0)
		emitter.Parent = slotData.body
		slotData.smoke = emitter
	end

	if slotData.statusLabel then
		slotData.statusLabel.Text = "Повреждено"
		slotData.statusLabel.TextColor3 = Color3.fromRGB(255, 120, 90)
	end

	Remotes.Get("BuildingStateChanged"):FireAllClients(plotId, slotIndex, {
		tier = slotData.tier,
		level = slotData.level,
		hp = slotData.hp,
		maxHp = slotData.maxHp,
		alive = slotData.alive,
		disabled = true,
		rebuildTimer = 0,
	})

	task.delay(duration, function()
		local cur = plotFarms[plotId] and plotFarms[plotId][slotIndex]
		if cur ~= slotData then return end -- здание было перестроено — старые данные не трогаем
		if not slotData.disabledUntil or workspace:GetServerTimeNow() < slotData.disabledUntil then return end
		slotData.disabledUntil = nil
		if slotData.disabledParts then
			for _, rec in ipairs(slotData.disabledParts) do
				if rec.part and rec.part.Parent then
					rec.part.Color = rec.color
					rec.part.Material = rec.material
				end
			end
			slotData.disabledParts = nil
		end
		if slotData.smoke then slotData.smoke:Destroy() slotData.smoke = nil end
		if slotData.statusLabel and slotData.alive then
			slotData.statusLabel.Text = string.format("ур.%d  +$%d", slotData.level or 1, Config.IncomeForLevel(slotData.tier, slotData.level or 1))
			slotData.statusLabel.TextColor3 = Color3.fromRGB(129, 255, 161)
		end
	end)
end

-- Серверный расчёт прилёта: находит здания в радиусе точки удара и наносит им
-- урон + отключает доход. Возвращает true, если что-то было разрушено.
function FarmManager.ApplyRocketImpact(plotId, impactPos, damage)
	local farms = plotFarms[plotId]
	local plot = PlotManager.GetPlot(plotId)
	if not farms or not plot then return false end

	local radius = Config.Rocket.ImpactRadius
	local anyDestroyed = false
	for slotIndex, slotData in pairs(farms) do
		if slotData and slotData.alive then
			local slot = plot.slots[slotIndex]
			if slot then
				local c = slot.center
				local flat = Vector3.new(c.X, impactPos.Y, c.Z)
				if (flat - impactPos).Magnitude <= radius then
					FarmManager.DisableSlot(plotId, slotIndex, Config.Rocket.DisableDuration)
					if FarmManager.DamageAtSlot(plotId, slotIndex, damage) then
						anyDestroyed = true
					end
				end
			end
		end
	end
	return anyDestroyed
end

function FarmManager.GetAllFarmData()
	return plotFarms
end

return FarmManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">PlotManager</string>
          <string name="Source"><![CDATA[-- PlotManager.luau - ocean world, sandy islands, wildlife, launchers, and rocket pads
--
-- v3: восемь КРУПНЫХ островов кольцом вокруг пустого центра (центральный остров
-- убран). На каждом острове 4 ракетных стенда; перед каждым — зелёный круг
-- покупки/прокачки. Внешний вид ракеты меняется каждые 5 уровней (Mark I..IV),
-- геометрия ракеты общая с летящей ракетой (см. RocketFactory).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)
local Config            = require(sharedFolder:WaitForChild("Config"))
local RocketFactory     = require(script.Parent:WaitForChild("RocketFactory"))

local PlotManager = {}

local plots = {}
local playerPlot = {}

local PLOT_THEME_COLORS = {
	Color3.fromRGB(46, 117, 224),  -- синий
	Color3.fromRGB(224, 76, 46),   -- красный
	Color3.fromRGB(46, 200, 90),   -- зелёный
	Color3.fromRGB(230, 180, 30),  -- жёлтый
	Color3.fromRGB(170, 50, 230),  -- фиолетовый
	Color3.fromRGB(40, 210, 210),  -- бирюзовый
	Color3.fromRGB(240, 120, 190), -- розовый
	Color3.fromRGB(255, 130, 40),  -- оранжевый
}

-- Высота ходибельной песчаной поверхности острова над Y центра плота.
-- Все объекты (спавн, кнопки, ракеты, пальмы) выравниваются по этой высоте.
local SURFACE_OFFSET = 10

local function makePart(parent, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Вспомогательные конструкторы для цилиндров и клиньев
local function makeCylinder(parent, name, height, diameter, position, color, material)
	-- Цилиндр в Roblox лежит вдоль локальной оси X; поворотом на 90° по Z ставим вертикально.
	local part = makePart(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

local function makeWedge(parent, name, size, cframe, color, material)
	local part = Instance.new("WedgePart")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Акула плавает ПОД водой и периодически всплывает так, что над поверхностью
-- видно ТОЛЬКО спинной плавник (как в кино) — тело никогда не выходит из воды.
local function buildShark(parent, index)
	local model = Instance.new("Model")
	model.Name = "Shark_" .. index
	model.Parent = parent

	-- Центр карты — пустая вода: акулы кружат именно там.
	local radius = 130 + (index % 4) * 70
	local angle = index / 16 * math.pi * 2
	local body = makePart(model, "Body", Vector3.new(4, 4, 13), CFrame.new(), Color3.fromRGB(67, 88, 101), Enum.Material.SmoothPlastic)
	body.Shape = Enum.PartType.Ball
	body.CanCollide = false
	local fin = makePart(model, "Fin", Vector3.new(0.7, 5, 5), CFrame.new(), body.Color, Enum.Material.SmoothPlastic)
	fin.CanCollide = false
	local tail = makePart(model, "Tail", Vector3.new(0.8, 7, 5), CFrame.new(), body.Color, Enum.Material.SmoothPlastic)
	tail.CanCollide = false
	model.PrimaryPart = body

	task.spawn(function()
		local t = angle
		local phase = index * 1.3
		-- Глубина "дышит" синусом: от -13 (глубоко) до -3 (у самой поверхности).
		-- На пике всплытия верх тела остаётся под водой, наружу торчит только плавник.
		local function depthAt(tt)
			return (Config.WATER_LEVEL - 3) - (math.sin(tt * 2.2 + phase) + 1) * 5
		end
		while model.Parent do
			t += 0.007
			local y = depthAt(t)
			local position = Vector3.new(math.cos(t) * radius, y, math.sin(t) * radius)
			local nextPosition = Vector3.new(math.cos(t + 0.03) * radius, depthAt(t + 0.03), math.sin(t + 0.03) * radius)
			model:PivotTo(CFrame.lookAt(position, nextPosition))
			fin.CFrame = body.CFrame * CFrame.new(0, 3, 1) * CFrame.Angles(0, 0, math.rad(45))
			tail.CFrame = body.CFrame * CFrame.new(0, 0, 7)
			task.wait(0.05)
		end
	end)
end

local function buildOcean()
	local terrain = workspace.Terrain
	terrain:Clear()
	-- Тропическая бирюзовая вода из Terrain (не плоский Part): мягкие блики,
	-- лёгкая волна, полупрозрачная толща — острова стоят заметно выше уровня воды.
	terrain.WaterColor = Color3.fromRGB(33, 171, 176)
	terrain.WaterTransparency = 0.7
	terrain.WaterReflectance = 0.4
	terrain.WaterWaveSize = 0.15
	terrain.WaterWaveSpeed = 12

	local waterDepth = Config.WATER_LEVEL - Config.SEABED_LEVEL
	terrain:FillBlock(
		CFrame.new(0, Config.SEABED_LEVEL + waterDepth / 2, 0),
		Vector3.new(Config.WORLD_SIZE, waterDepth, Config.WORLD_SIZE),
		Enum.Material.Water
	)
	terrain:FillBlock(
		CFrame.new(0, Config.SEABED_LEVEL - 5, 0),
		Vector3.new(Config.WORLD_SIZE, 10, Config.WORLD_SIZE),
		Enum.Material.Sand
	)

	-- Лёгкие кучевые облака над океаном (красивое небо почти бесплатно).
	local clouds = terrain:FindFirstChildOfClass("Clouds")
	if not clouds then
		clouds = Instance.new("Clouds")
		clouds.Parent = terrain
	end
	clouds.Cover = 0.42
	clouds.Density = 0.24
	clouds.Color = Color3.fromRGB(234, 241, 248)

	local world = Instance.new("Folder")
	world.Name = "OceanWildlife"
	world.Parent = workspace
	for index = 1, 16 do
		buildShark(world, index)
	end
end

-- Остров = набор ВЛОЖЕННЫХ сплошных цилиндров с верхними гранями на РАЗНОЙ высоте.
-- Никаких перекрывающихся копланарных партов → нет "плавающего/дрожащего песка" (z-fighting).
local function buildIslandBase(folder, position, sandColor)
	local scale = Config.PLOT_CENTER_SIZE
	local sandRadius = scale * 0.64

	-- Подводный риф (самый широкий, спрятан под каменным шельфом)
	makeCylinder(folder, "SubmergedReef", 20, (sandRadius * 2.3) + 12, position + Vector3.new(0, -20, 0), Color3.fromRGB(52, 73, 78), Enum.Material.Slate)
	-- Каменный шельф (верх +4 относительно position.Y)
	makeCylinder(folder, "RockShelf", 16, sandRadius * 2.14, position + Vector3.new(0, -4, 0), Color3.fromRGB(92, 87, 75), Enum.Material.Rock)
	-- Песчаная поверхность единым партом (верх = position.Y + SURFACE_OFFSET)
	local sand = makeCylinder(folder, "SandShore", 8, sandRadius * 2, position + Vector3.new(0, SURFACE_OFFSET - 4, 0), sandColor, Enum.Material.Sand)
	-- Зелёная лужайка в центре острова (площадь "городка"): нижняя грань чуть выше
	-- песка, чтобы не было копланарных граней.
	makeCylinder(folder, "TownLawn", 0.3, sandRadius, position + Vector3.new(0, SURFACE_OFFSET + 0.2, 0), Color3.fromRGB(118, 178, 92), Enum.Material.Grass)

	return sand, sandRadius
end

-- Деревянный трап с воды на южный берег: выпал за остров — заплыл к трапу
-- и поднялся обратно (раньше с воды было не залезть).
local function buildReturnRamp(folder, position)
	local ramp = makeWedge(
		folder,
		"ReturnRamp",
		Vector3.new(10, 22, 48),
		-- lookAt от острова: локальный +Z (высокая грань клина) смотрит на остров.
		CFrame.lookAt(position + Vector3.new(0, -1, 112), position + Vector3.new(0, -1, 200)),
		Color3.fromRGB(128, 90, 50),
		Enum.Material.WoodPlanks
	)
	ramp.CanCollide = true

	-- Пара свай у нижнего (водного) конца трапа
	for _, x in ipairs({ -4, 4 }) do
		makeCylinder(folder, "RampPost", 14, 1.4, position + Vector3.new(x, -17, 128), Color3.fromRGB(73, 52, 34), Enum.Material.Wood)
	end
end

-- Большая красивая пальма: изогнутый ствол из сегментов-цилиндров, крона из листьев и кокосы.
local function buildPalm(parent, basePos, yawDeg, scale)
	local model = Instance.new("Model")
	model.Name = "Palm"
	model.Parent = parent

	local segCount = math.random(4, 6)
	local segLen = 3.1 * scale
	local dia = 1.7 * scale
	local trunkColor = Color3.fromRGB(111, 77, 43)
	local lean = math.rad(6) -- лёгкий изгиб ствола сегмент за сегментом

	local growth = CFrame.new(basePos) * CFrame.Angles(0, math.rad(yawDeg), 0)
	for i = 1, segCount do
		local d = dia * (1 - (i - 1) * 0.09)
		local centerCF = growth * CFrame.new(0, segLen / 2, 0)
		local seg = makePart(model, "Trunk_" .. i, Vector3.new(segLen + 0.35, d, d), centerCF * CFrame.Angles(0, 0, math.rad(90)), trunkColor, Enum.Material.Wood)
		seg.Shape = Enum.PartType.Cylinder
		growth = growth * CFrame.new(0, segLen, 0) * CFrame.Angles(lean, 0, 0)
	end

	local crownPos = growth.Position

	-- 6-8 больших изогнутых листьев, наклонённых вниз от вершины
	local leaves = math.random(6, 8)
	local leafLen = 11 * scale
	for i = 1, leaves do
		local leafAngle = math.rad((360 / leaves) * i)
		local droop = -math.rad(26 + math.random(0, 14))
		local leafCF = CFrame.new(crownPos)
			* CFrame.Angles(0, leafAngle, 0)
			* CFrame.Angles(droop, 0, 0)
			* CFrame.new(0, 0, -leafLen / 2)
		local leaf = makePart(model, "Leaf_" .. i, Vector3.new(2.7 * scale, 0.4, leafLen), leafCF, Color3.fromRGB(53, 133, 71), Enum.Material.Grass)
		leaf.CanCollide = false
	end

	-- Плотная зелёная шапка в центре кроны
	local cap = makePart(model, "Crown", Vector3.new(2.6 * scale, 2 * scale, 2.6 * scale), CFrame.new(crownPos), Color3.fromRGB(60, 120, 66), Enum.Material.Grass)
	cap.Shape = Enum.PartType.Ball
	cap.CanCollide = false

	-- Пара кокосов под кроной
	for i = 1, 2 do
		local a = math.rad(i * 150 + 30)
		local coconut = makePart(model, "Coconut_" .. i, Vector3.new(1.2 * scale, 1.2 * scale, 1.2 * scale), CFrame.new(crownPos + Vector3.new(math.cos(a) * 1.7, -1.5 * scale, math.sin(a) * 1.7)), Color3.fromRGB(74, 47, 25), Enum.Material.SmoothPlastic)
		coconut.Shape = Enum.PartType.Ball
		coconut.CanCollide = false
	end

	return model
end

-- Расставляет пальмы и камни по песчаному кольцу острова, обходя зону ракетных
-- стендов (северная полоса), точку спавна, южный коридор к трапу и центр-лужайку.
local function buildIslandDecor(parent, position, plotId)
	local decor = Instance.new("Folder")
	decor.Name = "IslandDecor"
	decor.Parent = parent

	local spawnPos = position + Vector3.new(0, SURFACE_OFFSET, 40)

	local target = 8 + (plotId % 3) -- 8..10 пальм на остров
	local placed, attempts = 0, 0
	while placed < target and attempts < 80 do
		attempts += 1
		local ang = math.random() * math.pi * 2
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local radius = 55 + math.random() * 34
		local pos = position + dir * radius + Vector3.new(0, SURFACE_OFFSET, 0)

		local dx = pos.X - position.X
		local dz = pos.Z - position.Z
		-- Полоса ракетных стендов и зелёных кругов: не сажаем пальмы внутрь.
		local inLauncherZone = dz > -44 and dz < -8 and math.abs(dx) < 56
		-- Южный коридор к трапу (путь с воды к спавну) держим свободным.
		local inRampCorridor = dz > 26 and math.abs(dx) < 9
		if not inLauncherZone and not inRampCorridor and (pos - spawnPos).Magnitude > 14 then
			buildPalm(decor, pos, math.deg(ang) + math.random(-40, 40), 0.85 + math.random() * 0.55)
			placed += 1
		end
	end

	-- Прибрежные камни (наполовину в песке)
	for index, offset in ipairs({ Vector3.new(86, SURFACE_OFFSET - 1, -38), Vector3.new(-84, SURFACE_OFFSET - 1, 20), Vector3.new(34, SURFACE_OFFSET - 1, 84), Vector3.new(-26, SURFACE_OFFSET - 1, -80) }) do
		local rock = makePart(decor, "BeachRock_" .. index, Vector3.new(5 + index, 3 + index % 2, 5 + index), CFrame.new(position + offset), Color3.fromRGB(111, 105, 91), Enum.Material.Rock)
		rock.Shape = Enum.PartType.Ball
	end
end

local function buildIslandModel(plotId, position)
	local folder = Instance.new("Folder")
	folder.Name = "Plot_" .. plotId
	folder:SetAttribute("PlotId", plotId)
	folder:SetAttribute("OwnerUserId", 0)
	folder.Parent = workspace

	local themeColor = PLOT_THEME_COLORS[plotId] or Color3.fromRGB(150, 150, 150)

	-- Единые сплошные цилиндры вместо перекрывающихся сегментов (устраняет z-fighting песка).
	buildIslandBase(folder, position, Color3.fromRGB(235, 211, 149))
	buildIslandDecor(folder, position, plotId)
	buildReturnRamp(folder, position)

	-- Спавн НЕВИДИМ: раньше это был "второй квадрат песка", плававший над пляжем
	-- рядом с ракетой. Точка респавна работает, но геометрии больше не видно.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlotSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = position + Vector3.new(0, SURFACE_OFFSET + 1.05, 40)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = false
	spawn.Duration = 0
	spawn.Parent = folder

	-- Launcher models are added here as the player expands from one to four.
	local siloFolder = Instance.new("Folder")
	siloFolder.Name = "RocketSilo"
	siloFolder.Parent = folder

	-- Кнопки покупки зданий — плоские зелёные "блины" у кромки песка. Покупка/прокачка
	-- срабатывает по НАСТУПАНИЮ (Touched). Над каждой висит ценник (BillboardGui).
	local slotsData = {}
	local edgeR = Config.PLOT_CENTER_SIZE * 0.64 - 8
	for slotIdx, offset in ipairs(Config.SLOT_OFFSETS) do
		local dir = offset.Unit
		local edgePos = position + dir * edgeR
		-- Сдвигаем кнопку ВБОК от радиальной линии (по ней идёт мост/тропа) и слегка
		-- приподнимаем над песком: кнопка не пересекает мост, а её нижняя грань
		-- не копланарна песку (нет z-fighting).
		local side = dir:Cross(Vector3.new(0, 1, 0))
		local padPos = edgePos + side * 9 + Vector3.new(0, SURFACE_OFFSET + 0.8, 0)

		local buyPad = Instance.new("Part")
		buyPad.Name = "BuyPad_" .. slotIdx
		buyPad.Shape = Enum.PartType.Cylinder
		buyPad.Anchored = true
		buyPad.Size = Vector3.new(0.6, 8, 8)
		buyPad.Orientation = Vector3.new(0, 0, 90)
		buyPad.Position = padPos
		buyPad.Color = Color3.fromRGB(69, 200, 110)
		buyPad.Material = Enum.Material.Neon
		if slotIdx > 1 then
			-- Заблокированные слоты скрыты до постройки предыдущего.
			buyPad.Transparency = 1
			buyPad.CanCollide = false
		end
		buyPad.Parent = folder

		-- Ценник над кнопкой. Enabled = false: видимостью управляет клиент
		-- (PriceTags) — ценники показываются ТОЛЬКО на своём острове и ТОЛЬКО
		-- когда игрок стоит рядом (меньше текста на экране). Атрибут Unlocked
		-- отражает, открыт ли слот (последовательное открытие слотов).
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "PriceTag"
		billboard.Size = UDim2.new(0, 150, 0, 44)
		billboard.StudsOffset = Vector3.new(0, 5, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false
		billboard:SetAttribute("Unlocked", slotIdx == 1)
		billboard.Parent = buyPad

		-- Жирный читаемый шрифт (тонкий Medium выглядел «мерзко» на фоне мира).
		local priceLabel = Instance.new("TextLabel")
		priceLabel.Name = "PriceLabel"
		priceLabel.Size = UDim2.new(1, 0, 1, 0)
		priceLabel.BackgroundTransparency = 1
		priceLabel.TextScaled = false
		priceLabel.TextSize = 16
		priceLabel.Font = Enum.Font.GothamBold
		priceLabel.TextColor3 = Color3.fromRGB(245, 248, 250)
		priceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		priceLabel.TextStrokeTransparency = 0.35
		local cfg = Config.FARM_TYPES[slotIdx]
		priceLabel.Text = string.format("%s\n$%d", cfg.name, cfg.cost)
		priceLabel.Parent = billboard

		slotsData[slotIdx] = {
			center = position + offset,
			edgePos = edgePos,
			buyPad = buyPad,
			billboard = billboard,
			priceLabel = priceLabel,
		}
	end

	-- Зелёные круги ракет: ПЕРЕД каждым из 4 стендов. Наступание = покупка стенда
	-- (если ещё не куплен) или прокачка ракеты (если куплен). Состоянием управляет
	-- RocketManager через PlotManager.SetRocketPadState.
	local rocketPads = {}
	for padIdx, offset in ipairs(Config.LAUNCHER_OFFSETS) do
		local padPos = position + Vector3.new(offset.X, SURFACE_OFFSET + 0.55, offset.Z + Config.LAUNCHER_PAD_FORWARD)

		local pad = Instance.new("Part")
		pad.Name = "RocketPad_" .. padIdx
		pad.Shape = Enum.PartType.Cylinder
		pad.Anchored = true
		pad.Size = Vector3.new(0.5, 10, 10)
		pad.Orientation = Vector3.new(0, 0, 90)
		pad.Position = padPos
		pad.Color = Color3.fromRGB(64, 224, 130)
		pad.Material = Enum.Material.Neon
		pad.Transparency = 1
		pad.CanCollide = false
		pad.Parent = folder

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "PriceTag"
		billboard.Size = UDim2.new(0, 170, 0, 48)
		billboard.StudsOffset = Vector3.new(0, 5, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false
		billboard:SetAttribute("Unlocked", false)
		billboard.Parent = pad

		local label = Instance.new("TextLabel")
		label.Name = "PriceLabel"
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextScaled = false
		label.TextSize = 16
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.fromRGB(245, 248, 250)
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.TextStrokeTransparency = 0.35
		label.Text = ""
		label.Parent = billboard

		rocketPads[padIdx] = { pad = pad, billboard = billboard, label = label }
	end

	plots[plotId] = {
		owner = nil,
		folder = folder,
		center = position,
		spawn = spawn,
		slots = slotsData,
		rocketPads = rocketPads,
		themeColor = themeColor,
		launchers = {},
	}
end

local function assignPlayerToPlot(player)
	for id, plot in pairs(plots) do
		if plot.owner == nil then
			plot.owner = player
			playerPlot[player] = id
			player:SetAttribute("PlotId", id)
			plot.folder:SetAttribute("OwnerUserId", player.UserId)
			player.RespawnLocation = plot.spawn

			local char = player.Character or player.CharacterAdded:Wait()
			if char then
				task.wait(0.2)
				char:PivotTo(plot.spawn.CFrame + Vector3.new(0, 4, 0))
			end

			print(string.format("[PlotManager] %s успешно назначен на Остров #%d", player.Name, id))
			break
		end
	end
end

function PlotManager.Init()
	local oldWildlife = workspace:FindFirstChild("OceanWildlife")
	if oldWildlife then oldWildlife:Destroy() end
	-- Центральный остров убран: центр карты — открытая вода с акулами.
	local oldCentral = workspace:FindFirstChild("CentralIsland")
	if oldCentral then oldCentral:Destroy() end
	-- Убираем «зелёную поляну под водой» — Baseplate/спавн из шаблона Studio,
	-- если они остались в place-файле (по ним и "ходили" акулы).
	for _, strayName in ipairs({ "Baseplate", "SpawnLocation" }) do
		local stray = workspace:FindFirstChild(strayName)
		if stray then stray:Destroy() end
	end

	buildOcean()

	for i, pos in ipairs(Config.PLOT_POSITIONS) do
		buildIslandModel(i, pos)
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			local plotId = playerPlot[player]
			if plotId and plots[plotId] then
				task.wait(0.2)
				char:PivotTo(plots[plotId].spawn.CFrame + Vector3.new(0, 4, 0))
			end
		end)
		assignPlayerToPlot(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if not playerPlot[player] then
			assignPlayerToPlot(player)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		local id = playerPlot[player]
		if id then
			local plot = plots[id]
			if plot then
				plot.owner = nil
				plot.folder:SetAttribute("OwnerUserId", 0)
				plot.folder.RocketSilo:ClearAllChildren()
				plot.launchers = {}
				PlotManager.ResetRocketPads(id)
			end
			playerPlot[player] = nil
		end
	end)

	-- Страховка «выпал за карту»: раз в 3 секунды возвращаем на спавн тех, кто
	-- провалился под дно или уплыл за границу мира.
	task.spawn(function()
		local half = Config.WORLD_SIZE / 2 + 60
		while true do
			task.wait(3)
			for _, player in ipairs(Players:GetPlayers()) do
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local p = hrp.Position
					if p.Y < Config.SEABED_LEVEL - 2 or math.abs(p.X) > half or math.abs(p.Z) > half then
						local id = playerPlot[player]
						local plot = id and plots[id]
						if plot then
							char:PivotTo(plot.spawn.CFrame + Vector3.new(0, 4, 0))
						end
					end
				end
			end
		end
	end)
end

-- Создание стенда с ракетой нужного поколения (level определяет Mark).
function PlotManager.CreateLauncher(player, launcherIndex, level)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	if not plot then return nil end
	if plot.launchers[launcherIndex] then return plot.launchers[launcherIndex] end
	local offset = Config.LAUNCHER_OFFSETS[launcherIndex]
	if not offset then return nil end

	local mark = Config.RocketMark(level or 1)
	local model = Instance.new("Model")
	model.Name = "Launcher_" .. launcherIndex
	model:SetAttribute("LauncherIndex", launcherIndex)
	model:SetAttribute("RocketMark", mark)
	model.Parent = plot.folder:FindFirstChild("RocketSilo")

	local teamColor = plot.themeColor
	-- Ракета СТОИТ на песке: считаем уровень песка и ставим на него бетонную площадку.
	local sandY = plot.center.Y + SURFACE_OFFSET
	local basePos = Vector3.new(plot.center.X + offset.X, sandY, plot.center.Z + offset.Z)

	-- Бетонная площадка лежит на лужайке; нижняя грань не копланарна поверхности.
	local pad = makeCylinder(model, "Pad", 0.4, 13, basePos + Vector3.new(0, 0.45, 0), Color3.fromRGB(148, 150, 156), Enum.Material.Concrete)
	local rim = makeCylinder(model, "ReadyRim", 0.5, 14.4, basePos + Vector3.new(0, 0.66, 0), teamColor, Enum.Material.Neon)
	rim.CanCollide = false

	-- Сама ракета — из общего конструктора (та же геометрия, что у летящей).
	local parts, window, height = RocketFactory.Build(model, CFrame.new(basePos + Vector3.new(0, 0.65, 0)), teamColor, mark, 1, true)
	local origin = Vector3.new(basePos.X, basePos.Y + 0.65 + height + 2, basePos.Z)

	-- Запуск идёт через прицел (клавиша E на стенде), см. HudManager.

	model.PrimaryPart = pad
	plot.launchers[launcherIndex] = { model = model, parts = parts, window = window, rim = rim, origin = origin, mark = mark }
	return plot.launchers[launcherIndex]
end

-- Полная перестройка стенда (эволюция внешнего вида каждые 5 уровней).
function PlotManager.RebuildLauncher(player, launcherIndex, level)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	if not plot then return nil end
	local launcher = plot.launchers[launcherIndex]
	if launcher and launcher.model then
		launcher.model:Destroy()
	end
	plot.launchers[launcherIndex] = nil
	return PlotManager.CreateLauncher(player, launcherIndex, level)
end

function PlotManager.SetLauncherReady(player, launcherIndex, ready)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	local launcher = plot and plot.launchers[launcherIndex]
	if not launcher then return end
	local t = ready and 0 or 1
	for _, p in ipairs(launcher.parts) do
		p.Transparency = t
	end
	if launcher.window then launcher.window.Transparency = ready and 0.15 or 1 end
	if launcher.rim then launcher.rim.Color = ready and plot.themeColor or Color3.fromRGB(85, 91, 95) end
end

function PlotManager.GetLauncherOrigin(player, launcherIndex)
	local _, plot = PlotManager.GetPlotByPlayer(player)
	local launcher = plot and plot.launchers[launcherIndex]
	return launcher and launcher.origin
end

-- === Зелёные круги ракет ===
-- state: "buy" (купить стенд), "upgrade" (прокачать), "max" (потолок), "locked" (скрыт).
local ROCKET_PAD_COLORS = {
	buy = Color3.fromRGB(64, 224, 130),
	upgrade = Color3.fromRGB(64, 224, 130),
	max = Color3.fromRGB(240, 196, 90),
}

function PlotManager.SetRocketPadState(plotId, index, state, text)
	local plot = plots[plotId]
	local rp = plot and plot.rocketPads and plot.rocketPads[index]
	if not rp then return end

	if state == "locked" then
		rp.pad.Transparency = 1
		rp.pad.CanCollide = false
		rp.billboard:SetAttribute("Unlocked", false)
	else
		rp.pad.Transparency = state == "max" and 0.35 or 0
		rp.pad.CanCollide = state ~= "max"
		rp.pad.Color = ROCKET_PAD_COLORS[state] or ROCKET_PAD_COLORS.buy
		rp.billboard:SetAttribute("Unlocked", true)
		rp.label.Text = text or ""
		rp.label.TextColor3 = state == "max" and Color3.fromRGB(255, 224, 150) or Color3.fromRGB(240, 244, 246)
	end
end

function PlotManager.ResetRocketPads(plotId)
	for index = 1, Config.MAX_LAUNCHERS do
		PlotManager.SetRocketPadState(plotId, index, "locked")
	end
end

function PlotManager.GetPlotByPlayer(player)
	local id = playerPlot[player]
	return id, plots[id]
end

function PlotManager.GetPlot(plotId)
	return plots[plotId]
end

function PlotManager.GetAllPlots()
	return plots
end

function PlotManager.GetPlayerByPlot(plotId)
	local plot = plots[plotId]
	return plot and plot.owner
end

return PlotManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">RocketFactory</string>
          <string name="Source"><![CDATA[-- RocketFactory.luau — единая геометрия ракеты.
--
-- И стенд на базе (PlotManager), и летящая ракета (RocketManager) собираются
-- ЭТОЙ функцией — поэтому ракета в полёте выглядит ТОЧНО так же, как на базе:
-- то же поколение (Mark I..IV), тот же цвет команды, те же детали.
local RocketFactory = {}

local GOLD = Color3.fromRGB(255, 199, 70)

-- Поколения ракет: внешний вид меняется каждые 5 уровней прокачки.
RocketFactory.MARK_SPECS = {
	[1] = { -- классическая белая ракета
		dia = 4.6, bodyH = 15, noseH = 4.5, finH = 6.4, boosters = 0, rings = 0,
		bodyColor = Color3.fromRGB(236, 239, 241), bodyMat = Enum.Material.SmoothPlastic,
	},
	[2] = { -- с двумя боковыми ускорителями
		dia = 5.0, bodyH = 18, noseH = 5.2, finH = 7.2, boosters = 2, rings = 1,
		bodyColor = Color3.fromRGB(240, 243, 244), bodyMat = Enum.Material.SmoothPlastic,
	},
	[3] = { -- тяжёлая тёмная с неоновыми кольцами
		dia = 5.6, bodyH = 21, noseH = 5.8, finH = 8, boosters = 0, rings = 3,
		bodyColor = Color3.fromRGB(60, 64, 72), bodyMat = Enum.Material.Metal, dark = true,
	},
	[4] = { -- флагман: три ускорителя, золотой нос и неоновое гало
		dia = 6.0, bodyH = 23, noseH = 6.4, finH = 9, boosters = 3, rings = 2,
		bodyColor = Color3.fromRGB(245, 246, 248), bodyMat = Enum.Material.SmoothPlastic,
		goldAccent = true, halo = true,
	},
}

function RocketFactory.GetSpec(mark)
	return RocketFactory.MARK_SPECS[mark] or RocketFactory.MARK_SPECS[1]
end

-- Полная высота ракеты (от низа сопла до кончика шпиля) с учётом масштаба.
function RocketFactory.GetHeight(mark, scale)
	local spec = RocketFactory.GetSpec(mark)
	return (3.4 + spec.bodyH + spec.noseH + 2.0) * (scale or 1)
end

-- Строит ракету вдоль +Y базового CFrame: низ сопла на локальном y = 0.
-- scale — общий масштаб (1 для стенда, ~0.5 для летящей).
-- collideBody = true делает корпус коллизионным (только для стенда).
-- Возвращает: parts (для скрытия при перезарядке), window, height.
function RocketFactory.Build(model, baseCF, teamColor, mark, scale, collideBody)
	local spec = RocketFactory.GetSpec(mark)
	local s = scale or 1
	local accent = spec.goldAccent and GOLD or teamColor
	local parts = {}

	local function newPart(name, size, cf, color, material)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = false
		part.Size = size
		part.CFrame = cf
		part.Color = color
		part.Material = material
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end

	-- Вертикальный цилиндр в локальных координатах ракеты (ось = +Y базы).
	local function cyl(name, height, diameter, x, y, z, color, material)
		local part = newPart(name, Vector3.new(height * s, diameter * s, diameter * s), baseCF * CFrame.new(x * s, y * s, z * s) * CFrame.Angles(0, 0, math.rad(90)), color, material)
		part.Shape = Enum.PartType.Cylinder
		table.insert(parts, part)
		return part
	end

	-- Двигательный отсек: сопло, юбка и тёплое свечение
	cyl("Nozzle", 2.2, spec.dia * 0.62, 0, 1.1, 0, Color3.fromRGB(40, 42, 46), Enum.Material.Metal)
	cyl("Skirt", 1.6, spec.dia * 0.92, 0, 2.6, 0, Color3.fromRGB(70, 74, 80), Enum.Material.Metal)
	cyl("EngineGlow", 0.5, spec.dia * 0.5, 0, 0.35, 0, Color3.fromRGB(255, 170, 60), Enum.Material.Neon)

	-- Корпус
	local bodyCenterY = 3.4 + spec.bodyH / 2
	local body = cyl("Body", spec.bodyH, spec.dia, 0, bodyCenterY, 0, spec.bodyColor, spec.bodyMat)
	body.CanCollide = collideBody == true

	-- Полоса команды + неоновые кольца прокачанных версий
	cyl("Stripe", 2.0, spec.dia * 1.04, 0, bodyCenterY + spec.bodyH * 0.18, 0, accent, Enum.Material.SmoothPlastic)
	for r = 1, (spec.rings or 0) do
		cyl("Ring_" .. r, 0.7, spec.dia * 1.06, 0, 3.4 + spec.bodyH * r / (spec.rings + 1), 0, spec.dark and teamColor or accent, Enum.Material.Neon)
	end

	-- Иллюминатор (смотрит по локальному +Z)
	local window = newPart("Window", Vector3.new(0.5 * s, 1.6 * s, 1.6 * s), baseCF * CFrame.new(0, (bodyCenterY + spec.bodyH * 0.32) * s, (spec.dia / 2 + 0.05) * s) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(125, 214, 238), Enum.Material.Glass)
	window.Shape = Enum.PartType.Cylinder

	-- Конусообразный нос из сужающихся секций + шпиль
	local noseBottom = 3.4 + spec.bodyH
	local noseSegs = 5
	for i = 1, noseSegs do
		local d = spec.dia * (1 - (i / noseSegs) * 0.82)
		local segH = spec.noseH / noseSegs
		cyl("Nose_" .. i, segH, math.max(d, 0.6), 0, noseBottom + (i - 0.5) * segH, 0, accent, Enum.Material.SmoothPlastic)
	end
	local tipY = noseBottom + spec.noseH
	local tip = newPart("Tip", Vector3.new(0.5 * s, 2.2 * s, 0.5 * s), baseCF * CFrame.new(0, (tipY + 0.9) * s, 0), Color3.fromRGB(226, 228, 232), Enum.Material.Metal)
	table.insert(parts, tip)

	-- Неоновое гало флагмана
	if spec.halo then
		local halo = cyl("Halo", 0.4, spec.dia + 3, 0, tipY - 1, 0, accent, Enum.Material.Neon)
		halo.Transparency = 0.3
	end

	-- Боковые ускорители
	if (spec.boosters or 0) > 0 then
		local boosterD = spec.dia * 0.36
		local boosterH = spec.bodyH * 0.55
		for i = 1, spec.boosters do
			local a = math.rad(360 / spec.boosters * i + 90)
			local bx = math.cos(a) * (spec.dia / 2 + boosterD / 2 + 0.1)
			local bz = math.sin(a) * (spec.dia / 2 + boosterD / 2 + 0.1)
			cyl("Booster_" .. i, boosterH, boosterD, bx, 2.0 + boosterH / 2, bz, spec.bodyColor, spec.bodyMat)
			cyl("BoosterNose_" .. i, 1.4, boosterD * 0.55, bx, 2.0 + boosterH + 0.7, bz, accent, Enum.Material.SmoothPlastic)
		end
	end

	-- Стабилизаторы
	for i = 1, 4 do
		local a = math.rad(i * 90 + 45)
		local dist = spec.dia / 2 + 0.9
		local fin = Instance.new("WedgePart")
		fin.Name = "Fin_" .. i
		fin.Anchored = true
		fin.CanCollide = false
		fin.Size = Vector3.new(0.7 * s, spec.finH * s, 3.6 * s)
		fin.CFrame = baseCF * CFrame.new(math.cos(a) * dist * s, (spec.finH / 2 + 0.4) * s, math.sin(a) * dist * s) * CFrame.Angles(0, -a + math.rad(90), 0)
		fin.Color = accent
		fin.Material = Enum.Material.SmoothPlastic
		fin.TopSurface = Enum.SurfaceType.Smooth
		fin.BottomSurface = Enum.SurfaceType.Smooth
		fin.Parent = model
		table.insert(parts, fin)
	end

	return parts, window, RocketFactory.GetHeight(mark, s)
end

return RocketFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">RocketManager</string>
          <string name="Source"><![CDATA[-- RocketManager.luau - launcher purchases, upgrades, reloads, and authoritative combat
--
-- v3: покупка и прокачка стендов идёт наступанием на зелёный круг перед стендом
-- (rocketPads из PlotManager). Урон ракеты растёт с уровнем стенда, а каждые
-- 5 уровней стенд перестраивается в новое поколение (Mark I..IV).
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config            = require(sharedFolder:WaitForChild("Config"))
local Remotes           = require(sharedFolder:WaitForChild("Remotes"))
local DataManager       = require(script.Parent:WaitForChild("DataManager"))
local PlotManager       = require(script.Parent:WaitForChild("PlotManager"))
local FarmManager       = require(script.Parent:WaitForChild("FarmManager"))
local RocketFactory     = require(script.Parent:WaitForChild("RocketFactory"))

local RocketManager = {}

local launcherReady = {}
local lastRequest = {}

-- Анти-двойное срабатывание зелёных кругов: после покупки/прокачки игрок обязан
-- СОЙТИ с круга, прежде чем тот сработает снова (фикс «стоит 410, списалось ~700»).
local padLock = {} -- [key] = { player, pos, radius }

task.spawn(function()
	while true do
		task.wait(0.25)
		for key, rec in pairs(padLock) do
			local char = rec.player and rec.player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not rec.player.Parent or not hrp then
				padLock[key] = nil
			else
				local flat = Vector3.new(hrp.Position.X - rec.pos.X, 0, hrp.Position.Z - rec.pos.Z)
				if flat.Magnitude > rec.radius then
					padLock[key] = nil
				end
			end
		end
	end
end)

local function notify(player, message, kind)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

-- Близость к установке больше НЕ требуется: ракету можно отправить и с кнопки
-- Attack (удалённо). Если клиент передал номер стенда (стоял у него по E или
-- выбрал в меню) — летит ИМЕННО этот стенд, а не первый готовый.

-- Летящая ракета строится СЕРВЕРОМ (реплицируется всем) из ТОГО ЖЕ конструктора,
-- что и стенд на базе (RocketFactory): то же поколение Mark, тот же цвет команды,
-- те же детали — в полёте ракета выглядит точно как на базе (масштаб 0.5, нос по -Z).
local FLY_SCALE = 0.5

local function buildFlyingRocket(originPos, mark, teamColor)
	local model = Instance.new("Model")
	model.Name = "FlyingRocket"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.4, 0.4, 0.4)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CFrame = CFrame.new(originPos)
	root.Parent = model
	model.PrimaryPart = root

	-- Ось ракеты (+Y конструктора) разворачиваем в -Z корня (нос вперёд),
	-- центр корпуса совмещаем с корнем.
	local height = RocketFactory.GetHeight(mark, FLY_SCALE)
	local baseCF = root.CFrame * CFrame.Angles(math.rad(-90), 0, 0) * CFrame.new(0, -height / 2, 0)
	RocketFactory.Build(model, baseCF, teamColor, mark, FLY_SCALE, false)

	local front = Instance.new("Attachment")
	front.Position = Vector3.new(0, 0, -height * 0.55)
	front.Parent = root
	local back = Instance.new("Attachment")
	back.Position = Vector3.new(0, 0, height * 0.5)
	back.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = front
	trail.Attachment1 = back
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 205, 70), teamColor)
	trail.Lifetime = 0.35
	trail.MinLength = 0.4
	trail.Parent = root

	local light = Instance.new("PointLight")
	light.Brightness = 8
	light.Range = 20
	light.Color = Color3.fromRGB(255, 150, 50)
	light.Parent = root

	-- Звук полёта: свист двигателя (луп, встроенный ассет Roblox — всегда доступен)
	-- и «выстрел» на старте. Громкость лупа плавно гасится перед прилётом.
	local whoosh = Instance.new("Sound")
	whoosh.Name = "FlightLoop"
	whoosh.SoundId = "rbxasset://sounds/Rocket whoosh 01.wav"
	whoosh.Looped = true
	whoosh.Volume = 0
	whoosh.RollOffMinDistance = 15
	whoosh.RollOffMaxDistance = 350
	whoosh.Parent = root
	whoosh:Play()

	local shot = Instance.new("Sound")
	shot.Name = "LaunchShot"
	shot.SoundId = "rbxasset://sounds/Rocket shot.wav"
	shot.Volume = 0.65
	shot.RollOffMaxDistance = 300
	shot.Parent = root
	shot:Play()

	return model
end

local function arcPos(origin, target, t)
	local straight = origin:Lerp(target, t)
	local height = math.sin(t * math.pi) * Config.ROCKET_ARC
	return Vector3.new(straight.X, straight.Y + height, straight.Z)
end

-- Спавнит ракету, ведёт её по баллистической дуге на сервере, просит клиента
-- стрелка вести камеру за этим инстансом, затем вызывает onImpact в точке удара.
local function flyRocket(shooter, originPos, targetPos, mark, teamColor, onImpact)
	local model = buildFlyingRocket(originPos, mark, teamColor)
	model.Parent = workspace

	-- Клиенту-стрелку сообщаем, какую ракету вести камерой.
	if shooter and shooter.Parent then
		Remotes.Get("RocketFollow"):FireClient(shooter, model, targetPos)
	end

	task.spawn(function()
		local root = model.PrimaryPart
		local whoosh = root and root:FindFirstChild("FlightLoop")
		local dist = (targetPos - originPos).Magnitude
		local duration = math.clamp(dist / Config.ROCKET_SPEED, 0.9, Config.ROCKET_ANIM_TIME)
		local elapsed = 0
		while elapsed < duration and model.Parent do
			local dt = RunService.Heartbeat:Wait()
			elapsed += dt
			local t = math.clamp(elapsed / duration, 0, 1)
			local pos = arcPos(originPos, targetPos, t)
			local nextPos = arcPos(originPos, targetPos, math.min(t + 0.04, 1))
			local dir = nextPos - pos
			if dir.Magnitude > 0.001 then
				model:PivotTo(CFrame.lookAt(pos, pos + dir))
			else
				model:PivotTo(CFrame.new(pos))
			end
			-- Плавная огибающая свиста: быстрый вход в начале, затухание к прилёту.
			if whoosh then
				if t < 0.12 then
					whoosh.Volume = 0.55 * (t / 0.12)
				elseif t > 0.85 then
					whoosh.Volume = 0.55 * math.max(0, 1 - (t - 0.85) / 0.15)
				else
					whoosh.Volume = 0.55
				end
			end
		end
		model:Destroy()
		if onImpact then onImpact() end
	end)
end

local function sendRocketState(player)
	local count = DataManager.GetLauncherCount(player)
	local readyCount = 0
	local reloads = {}
	local now = workspace:GetServerTimeNow()
	for index = 1, count do
		local readyAt = launcherReady[player] and launcherReady[player][index] or 0
		if readyAt <= now then readyCount += 1 else reloads[index] = math.max(0, readyAt - now) end
	end
	Remotes.Get("RocketStateChanged"):FireClient(player, {
		launchers = count,
		ready = readyCount,
		reloads = reloads,
	})
end

-- Актуализирует зелёные круги стендов: прокачка / покупка следующего / скрыто.
local function refreshPads(player)
	local plotId = select(1, PlotManager.GetPlotByPlayer(player))
	if not plotId then return end
	local count = DataManager.GetLauncherCount(player)
	for index = 1, Config.MAX_LAUNCHERS do
		if index <= count then
			local level = DataManager.GetLauncherLevel(player, index)
			if level >= Config.MAX_ROCKET_LEVEL then
				PlotManager.SetRocketPadState(plotId, index, "max", string.format("Ракета ур.%d\nМАКС. УРОВЕНЬ", level))
			else
				PlotManager.SetRocketPadState(plotId, index, "upgrade", string.format("Прокачка ур.%d → %d\n$%d", level, level + 1, Config.RocketUpgradeCost(level + 1)))
			end
		elseif index == count + 1 then
			PlotManager.SetRocketPadState(plotId, index, "buy", string.format("Купить ракету %d\n$%d", index, Config.LAUNCHER_COSTS[index]))
		else
			PlotManager.SetRocketPadState(plotId, index, "locked")
		end
	end
end

local function createOwnedLaunchers(player)
	launcherReady[player] = launcherReady[player] or {}
	for index = 1, DataManager.GetLauncherCount(player) do
		PlotManager.CreateLauncher(player, index, DataManager.GetLauncherLevel(player, index))
		launcherReady[player][index] = launcherReady[player][index] or 0
	end
	refreshPads(player)
	sendRocketState(player)
end

-- Наступание владельца на зелёный круг: покупка следующего стенда или прокачка купленного.
local function onPadStep(player, index)
	local count = DataManager.GetLauncherCount(player)

	if index <= count then
		-- ПРОКАЧКА
		local level = DataManager.GetLauncherLevel(player, index)
		if level >= Config.MAX_ROCKET_LEVEL then return end
		local oldMark = Config.RocketMark(level)
		local ok, result = DataManager.UpgradeLauncher(player, index)
		if not ok then
			notify(player, result, "error")
			return
		end
		local newMark = Config.RocketMark(result)
		if newMark ~= oldMark then
			-- Эволюция внешнего вида каждые 5 уровней.
			PlotManager.RebuildLauncher(player, index, result)
			local now = workspace:GetServerTimeNow()
			local readyAt = launcherReady[player] and launcherReady[player][index] or 0
			PlotManager.SetLauncherReady(player, index, readyAt <= now)
			notify(player, string.format("Ракета %d эволюционировала — Mk %d!", index, newMark), "success")
		else
			notify(player, string.format("Ракета %d прокачана до ур.%d", index, result), "success")
		end
		refreshPads(player)
	elseif index == count + 1 then
		-- ПОКУПКА следующего стенда
		local ok, result = DataManager.BuyNextLauncher(player)
		if not ok then
			notify(player, result, "error")
			return
		end
		launcherReady[player] = launcherReady[player] or {}
		launcherReady[player][result] = 0
		PlotManager.CreateLauncher(player, result, 1)
		sendRocketState(player)
		refreshPads(player)
		notify(player, string.format("Установка %d построена", result), "success")
	end
end

-- Пытается «застолбить» конкретный стенд: ставит его на перезарядку и возвращает true.
local function tryTakeLauncher(player, index)
	local now = workspace:GetServerTimeNow()
	launcherReady[player] = launcherReady[player] or {}
	if (launcherReady[player][index] or 0) <= now then
		launcherReady[player][index] = now + Config.ROCKET_RELOAD
		PlotManager.SetLauncherReady(player, index, false)
		sendRocketState(player)
		task.delay(Config.ROCKET_RELOAD, function()
			if player.Parent and launcherReady[player] and launcherReady[player][index] then
				launcherReady[player][index] = 0
				PlotManager.SetLauncherReady(player, index, true)
				sendRocketState(player)
			end
		end)
		return true
	end
	return false
end

-- preferredIndex: стенд, у которого игрок стоял (E) или который выбрал в меню
-- Attack — стреляет ИМЕННО он. Без preferredIndex берём первый готовый.
local function takeReadyLauncher(player, preferredIndex)
	local count = DataManager.GetLauncherCount(player)
	if preferredIndex then
		if preferredIndex >= 1 and preferredIndex <= count and tryTakeLauncher(player, preferredIndex) then
			return preferredIndex
		end
		return nil
	end
	for index = 1, count do
		if tryTakeLauncher(player, index) then
			return index
		end
	end
	return nil
end

function RocketManager.Init()
	local launchEvent = Remotes.Get("LaunchRocket")

	local function setupPlayer(player)
		task.spawn(function()
			for _ = 1, 30 do
				if not player.Parent then return end
				local plotId = select(1, PlotManager.GetPlotByPlayer(player))
				if plotId and DataManager.GetData(player) then
					createOwnedLaunchers(player)
					return
				end
				task.wait(0.2)
			end
		end)
	end
	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(function(player)
		launcherReady[player] = nil
		lastRequest[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end

	-- Наступание на зелёные круги стендов: ровно ОДИН раз за визит (надо сойти
	-- с круга, чтобы он сработал снова) — никаких двойных списаний.
	for plotId, plot in pairs(PlotManager.GetAllPlots()) do
		for index, rp in pairs(plot.rocketPads or {}) do
			rp.pad.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if not player or plot.owner ~= player then return end
				local key = string.format("%d:%d:%d", player.UserId, plotId, index)
				if padLock[key] then return end
				padLock[key] = { player = player, pos = rp.pad.Position, radius = 8 }
				onPadStep(player, index)
			end)
		end
	end

	-- Совместимость: старый ремоут покупки установки (основной путь — зелёные круги).
	Remotes.Get("BuyLauncher").OnServerEvent:Connect(function(player)
		local success, result = DataManager.BuyNextLauncher(player)
		if not success then notify(player, result, "error") return end
		launcherReady[player] = launcherReady[player] or {}
		launcherReady[player][result] = 0
		PlotManager.CreateLauncher(player, result, 1)
		sendRocketState(player)
		refreshPads(player)
		notify(player, string.format("Установка %d построена", result), "success")
	end)

	-- Клиент шлёт целевой остров, точку прицела (raycast по 3D-миру) и, опционально,
	-- номер стенда (стоял у него по E / выбрал в меню Attack).
	launchEvent.OnServerEvent:Connect(function(player, targetPlotId, targetPos, launcherIndexArg)
		local now = os.clock()
		if now - (lastRequest[player] or 0) < 0.2 then return end
		lastRequest[player] = now
		if type(targetPlotId) ~= "number" or targetPlotId % 1 ~= 0 then return end

		local targetPlot = PlotManager.GetPlot(targetPlotId)
		local myPlotId = select(1, PlotManager.GetPlotByPlayer(player))
		-- Можно бить по ЛЮБОМУ острову (в т.ч. пустому без владельца), кроме своего.
		if not targetPlot or myPlotId == targetPlotId then
			notify(player, "Недопустимая цель", "error")
			return
		end

		local preferredIndex = nil
		if type(launcherIndexArg) == "number" and launcherIndexArg % 1 == 0 then
			preferredIndex = launcherIndexArg
		end

		local launcherIndex = takeReadyLauncher(player, preferredIndex)
		if not launcherIndex then
			notify(player, preferredIndex and "Эта ракета перезаряжается" or "Все ракеты перезаряжаются", "error")
			return
		end
		local originPos = PlotManager.GetLauncherOrigin(player, launcherIndex)
		if not originPos then return end

		-- Урон и внешний вид летящей ракеты зависят от уровня выбранного стенда.
		local level = DataManager.GetLauncherLevel(player, launcherIndex)
		local damage = Config.RocketDamageForLevel(level)
		local mark = Config.RocketMark(level)
		local _, myPlot = PlotManager.GetPlotByPlayer(player)
		local teamColor = myPlot and myPlot.themeColor or Color3.fromRGB(220, 70, 60)

		-- Точка удара: либо переданная клиентом точка (ограниченная областью острова,
		-- чтобы нельзя было целиться мимо карты), либо центр острова со случайным разбросом.
		local impactPos
		if typeof(targetPos) == "Vector3" then
			local flat = Vector3.new(targetPos.X, targetPlot.center.Y, targetPos.Z)
			local off = flat - targetPlot.center
			local maxR = Config.PLOT_CENTER_SIZE
			if off.Magnitude > maxR then off = off.Unit * maxR end
			impactPos = targetPlot.center + off + Vector3.new(0, 10, 0)
		else
			impactPos = targetPlot.center + Vector3.new((math.random() - 0.5) * 30, 10, (math.random() - 0.5) * 30)
		end

		flyRocket(player, originPos, impactPos, mark, teamColor, function()
			-- Авторитетный прилёт: урон/оглушение зданий считает сервер.
			local destroyed = FarmManager.ApplyRocketImpact(targetPlotId, impactPos, damage)
			Remotes.Get("RocketImpact"):FireAllClients({
				pos = impactPos,
				destroyed = destroyed,
				shooterName = player.DisplayName,
				shooterUserId = player.UserId,
				targetPlotId = targetPlotId,
			})
		end)
	end)
end

return RocketManager
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="17">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="18">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="19">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- init.client.luau - Rojo client entry point
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes    = require(sharedFolder:WaitForChild("Remotes"))
local HudManager = require(script:WaitForChild("HudManager"))
local RocketAnim = require(script:WaitForChild("RocketAnim"))
local VisualFX   = require(script:WaitForChild("VisualFX"))
local PriceTags  = require(script:WaitForChild("PriceTags"))
local Sprint     = require(script:WaitForChild("Sprint"))

-- Получение настроек анимации
local getAnimFn = Remotes.Get("GetAnimSetting")
local animEnabled = true
pcall(function()
	animEnabled = getAnimFn:InvokeServer()
end)

-- Инициализация HUD и ценников (видны только на своём острове)
HudManager.Init(animEnabled)
PriceTags.Init()

-- Спринт на Shift: персонаж бежит немного быстрее
Sprint.Init()

-- Камера стрелка следует за запущенной сервером ракетой
local rocketFollow = Remotes.Get("RocketFollow")
rocketFollow.OnClientEvent:Connect(function(rocketModel)
	RocketAnim.Follow(rocketModel, HudManager.IsAnimEnabled())
end)

-- Прилёт ракеты: взрыв + звук + уведомление (у всех игроков)
local rocketImpact = Remotes.Get("RocketImpact")
rocketImpact.OnClientEvent:Connect(function(data)
	RocketAnim.Impact(data)
end)

local updateData = Remotes.Get("UpdateData")
updateData.OnClientEvent:Connect(function(data)
	HudManager.UpdateData(data)
end)

local rocketState = Remotes.Get("RocketStateChanged")
rocketState.OnClientEvent:Connect(function(data)
	HudManager.UpdateRocketState(data)
end)

-- Текстовых уведомлений больше нет: ошибки — красная вспышка денежного счётчика,
-- успехи — зелёная (сама сумма и так анимируется при изменении).
local notify = Remotes.Get("Notify")
notify.OnClientEvent:Connect(function(_message, kind)
	HudManager.FlashFeedback(kind)
end)

local spawnIncomeFX = Remotes.Get("SpawnIncomeFX")
spawnIncomeFX.OnClientEvent:Connect(function(pos, amount)
	VisualFX.SpawnIncome(pos, amount)
end)

print("[Client] Rocket Islands client connected")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">HudManager</string>
            <string name="Source"><![CDATA[-- HudManager.luau — деньги (внизу по центру), кнопка Attack (слева по центру),
-- настройки (⚙ справа снизу) и сценарий ракетного удара. НИКАКИХ текстовых плашек
-- по центру экрана: ошибки — красная вспышка денежного счётчика, подсказки прицела —
-- одна строка под верхней плашкой во время прицеливания.
--
-- Два пути запуска:
--   А) Подойти к своему стенду и зажать E (быстрое удержание) — стреляет ИМЕННО
--      этот стенд.
--   Б) Кнопка ATTACK слева: открывается список ракет («Ракета N — ОТПРАВИТЬ»),
--      можно стрелять откуда угодно, без подхода к стендам.
-- Дальше одинаково: камера сразу у вражеского острова, A/D или ◀ ▶ листают цели
-- (между стрелками — ник владельца), клик ставит маркер, ЗАПУСК отправляет.
-- Сервер независимо проверяет права, остров и точку — клиенту не доверяем.
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Remotes           = require(sharedFolder:WaitForChild("Remotes"))
local Config            = require(sharedFolder:WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local mouse = player:GetMouse()

local HudManager = {}

local animEnabled = true
local rocketReady = Config.START_LAUNCHERS
local launcherCount = Config.START_LAUNCHERS
local rocketLevels = {}
local reloadEndsAt = {} -- [index] = os.clock() + секунд до готовности

-- Деньги (нижняя панель)
local moneyText, moneyStroke, moneyLogoScale
local shownMoney = 0
local moneyThread, moneyPopTween
local flashToken = 0

-- Настройки (шестерёнка) и Attack-меню
local gearBtn, settingsPanel, animToggleBtn
local settingsOpen = false
local attackBtn, attackPanel
local attackOpen = false
local rowButtons = {}

-- Состояние сценария прицеливания.
local topBar, ownerLabel, islandLabel, hintLabel, launchButton
local targetingActive = false
local targets = {}      -- { {plotId, ownerUserId}, ... }
local targetIndex = 0
local aimPos = nil
local aimMarker = nil
local pendingLauncherIndex = nil -- какой стенд стреляет (E у стенда / выбор в Attack)

-- Заморозка передвижения на время прицеливания (камера уходит к цели).
local humFrozen = false
local savedJumpPower, savedJumpHeight

-- Сохранённое состояние камеры для восстановления после прицеливания.
local cameraFocused = false
local savedCameraType, savedCameraSubject

local GOLD_TEXT = Color3.fromRGB(255, 227, 125)
local GOLD_STROKE = Color3.fromRGB(255, 214, 90)

local function makeFrame(parent, size, pos, color, alpha, name)
	local f = Instance.new("Frame")
	f.Name = name or "Frame"
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or Color3.fromRGB(25, 25, 35)
	f.BackgroundTransparency = alpha or 0.15
	f.BorderSizePixel = 0
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = f
	return f
end

-- Панель с плавным появлением/исчезновением (CanvasGroup умеет фейдить всё разом).
local function makeCanvasPanel(parent, size, pos, name)
	local p = Instance.new("CanvasGroup")
	p.Name = name or "Panel"
	p.Size = size
	p.Position = pos
	p.BackgroundColor3 = Color3.fromRGB(14, 18, 24)
	p.BackgroundTransparency = 0.06
	p.BorderSizePixel = 0
	p.GroupTransparency = 1
	p.Visible = false
	p.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 14)
	c.Parent = p
	return p
end

local function fadePanel(panel, open)
	if not panel then return end
	if open then
		panel.Visible = true
		panel.GroupTransparency = 1
		TweenService:Create(panel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 }):Play()
	else
		local t = TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
		t.Completed:Once(function()
			if panel.GroupTransparency >= 0.99 then panel.Visible = false end
		end)
		t:Play()
	end
end

local function makeLabel(parent, text, size, pos, color, fontSize, font)
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	l.TextSize = fontSize or 15
	l.Font = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function makeButton(parent, text, size, pos, bgColor, textColor)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = bgColor or Color3.fromRGB(50, 120, 220)
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
	b.TextSize = 14
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	b.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = b
	return b
end

-- Вспышка денежного счётчика вместо текстовых уведомлений: красная — ошибка
-- (не хватает денег и т.п.), зелёная — успех. Никаких плашек по центру экрана.
function HudManager.FlashFeedback(kind)
	if not moneyText then return end
	flashToken += 1
	local token = flashToken
	local color = kind == "error" and Color3.fromRGB(255, 90, 80) or Color3.fromRGB(120, 235, 150)
	moneyText.TextColor3 = color
	if moneyStroke then
		moneyStroke.Color = color
		moneyStroke.Transparency = 0.2
	end
	task.delay(0.5, function()
		if flashToken ~= token then return end
		if moneyText then moneyText.TextColor3 = GOLD_TEXT end
		if moneyStroke then
			moneyStroke.Color = GOLD_STROKE
			moneyStroke.Transparency = 0.72
		end
	end)
end

-- Совместимость со старым API: текстовых уведомлений больше нет.
function HudManager.ShowNotification(_text, _color)
	HudManager.FlashFeedback("error")
end

-- Подсказка прицела (видна только во время прицеливания, под верхней плашкой).
local function setHint(text, color)
	if hintLabel and hintLabel.Visible then
		hintLabel.Text = text
		hintLabel.TextColor3 = color or Color3.fromRGB(255, 214, 90)
	end
end

-- Идём вверх по иерархии клика до папки острова (у неё есть атрибут PlotId).
local function findClickedPlot(part)
	local current = part
	while current and current ~= workspace do
		if current:GetAttribute("PlotId") ~= nil then
			return current:GetAttribute("PlotId")
		end
		current = current.Parent
	end
	return nil
end

-- === Маркер точки удара (только визуальный, локальный клиенту) ===
local function ensureMarker()
	if aimMarker and aimMarker.Parent then return aimMarker end
	local m = Instance.new("Model")
	m.Name = "RocketAimMarker"

	local beam = Instance.new("Part")
	beam.Name = "Beam"
	beam.Shape = Enum.PartType.Cylinder
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 70, 55)
	beam.Transparency = 0.25
	beam.Size = Vector3.new(60, 2, 2)
	beam.Parent = m

	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 120, 60)
	ring.Transparency = 0.15
	ring.Size = Vector3.new(1, 16, 16)
	ring.Parent = m

	aimMarker = m
	return m
end

local function showMarker(pos)
	local m = ensureMarker()
	-- Цилиндры лежат вдоль локального X; поворот на 90° по Z ставит их вертикально.
	m.Beam.CFrame = CFrame.new(pos + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
	m.Ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	m.Parent = workspace
end

local function clearMarker()
	if aimMarker then aimMarker.Parent = nil end
end

-- === Камера: обзор выбранного острова сверху под углом ===
local function focusCameraOnIsland(plotId)
	local center = Config.PLOT_POSITIONS[plotId]
	if not center then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	if not cameraFocused then
		savedCameraType = camera.CameraType
		savedCameraSubject = camera.CameraSubject
		cameraFocused = true
	end
	camera.CameraType = Enum.CameraType.Scriptable
	local target = CFrame.lookAt(center + Vector3.new(0, 340, 150), center)
	TweenService:Create(camera, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = target,
	}):Play()
end

local function restoreCamera()
	if not cameraFocused then return end
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCameraType or Enum.CameraType.Custom
		if savedCameraSubject then camera.CameraSubject = savedCameraSubject end
	end
	cameraFocused = false
end

-- === Заморозка/разморозка передвижения ===
local function setFrozen(on)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if on then
		if not humFrozen then
			savedJumpPower = hum.JumpPower
			savedJumpHeight = hum.JumpHeight
			humFrozen = true
		end
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
	elseif humFrozen then
		-- Возвращаем скорость с учётом спринта (Shift может быть зажат прямо сейчас).
		local sprinting = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		hum.WalkSpeed = sprinting and Config.SPRINT_SPEED or Config.WALK_SPEED
		hum.JumpPower = savedJumpPower or 0
		hum.JumpHeight = savedJumpHeight or 7.2
		humFrozen = false
	end
end

-- === Кнопка запуска: активна только когда выбрана точка удара ===
local function setLaunchEnabled(enabled)
	if not launchButton then return end
	launchButton.Active = enabled
	launchButton.AutoButtonColor = enabled
	launchButton.BackgroundColor3 = enabled and Color3.fromRGB(205, 67, 55) or Color3.fromRGB(60, 66, 74)
	launchButton.TextColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 158, 166)
end

-- Полное закрытие сценария: панели, маркер, камера, заморозка.
function HudManager.CloseTargeting()
	targetingActive = false
	targetIndex = 0
	aimPos = nil
	pendingLauncherIndex = nil
	clearMarker()
	restoreCamera()
	setFrozen(false)
	if topBar then topBar.Visible = false end
	if hintLabel then hintLabel.Visible = false end
	if launchButton then launchButton.Visible = false end
end

-- Список допустимых островов-целей (все, кроме своего). Занятые — первыми.
local function collectTargets()
	local myId = player:GetAttribute("PlotId")
	local entries = {}
	for _, folder in ipairs(workspace:GetChildren()) do
		local pid = folder:GetAttribute("PlotId")
		if pid ~= nil and pid ~= myId then
			table.insert(entries, { plotId = pid, ownerUserId = folder:GetAttribute("OwnerUserId") or 0 })
		end
	end
	table.sort(entries, function(a, b)
		local ao, bo = a.ownerUserId ~= 0, b.ownerUserId ~= 0
		if ao ~= bo then return ao end
		return a.plotId < b.plotId
	end)
	return entries
end

-- Верхняя плашка: ◀ [ник владельца острова] ▶
local function updateHeader()
	local entry = targets[targetIndex]
	if not entry then return end
	local folder = workspace:FindFirstChild("Plot_" .. entry.plotId)
	local ownerUserId = folder and folder:GetAttribute("OwnerUserId") or 0
	local ownerName = "Свободный остров"
	if ownerUserId ~= 0 then
		local p = Players:GetPlayerByUserId(ownerUserId)
		ownerName = p and p.DisplayName or ("Игрок " .. ownerUserId)
	end
	if ownerLabel then
		ownerLabel.Text = ownerName
		ownerLabel.TextColor3 = ownerUserId ~= 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 175, 182)
	end
	if islandLabel then
		islandLabel.Text = string.format("Остров #%d   •   %d / %d", entry.plotId, targetIndex, #targets)
	end
end

-- Переключение на цель под номером index (с закольцовкой).
local function selectTarget(index)
	if #targets == 0 then return end
	targetIndex = ((index - 1) % #targets) + 1
	aimPos = nil
	clearMarker()
	setLaunchEnabled(false)
	if hintLabel then
		hintLabel.Text = "Кликните по острову — точка удара   •   A / D — сменить остров   •   Q — выход"
		hintLabel.TextColor3 = Color3.fromRGB(255, 214, 90)
	end
	updateHeader()
	focusCameraOnIsland(targets[targetIndex].plotId)
end

-- Открыть сценарий. launcherIndex — какой стенд стреляет: с ProximityPrompt (E у
-- конкретного стенда) или из меню Attack. Камера сразу уходит на вражеский остров.
function HudManager.OpenTargeting(launcherIndex)
	if targetingActive then return end
	if player:GetAttribute("PlotId") == nil then return end
	targets = collectTargets()
	if #targets == 0 then
		HudManager.FlashFeedback("error")
		return
	end
	targetingActive = true
	aimPos = nil
	pendingLauncherIndex = launcherIndex
	clearMarker()
	setFrozen(true)
	setLaunchEnabled(false)
	if attackOpen then
		attackOpen = false
		fadePanel(attackPanel, false)
	end
	if topBar then topBar.Visible = true end
	if hintLabel then hintLabel.Visible = true end
	if launchButton then launchButton.Visible = true end
	selectTarget(1)
end

-- Подтверждение запуска: вызываем серверную логику с правильными аргументами.
local function doLaunch()
	if not targetingActive or targetIndex == 0 then return end
	local entry = targets[targetIndex]
	if not entry then return end
	if not aimPos then
		setHint("Сначала выберите точку удара — кликните по острову", Color3.fromRGB(255, 180, 40))
		return
	end
	if pendingLauncherIndex == nil and rocketReady <= 0 then
		setHint("Все ракеты перезаряжаются", Color3.fromRGB(255, 110, 95))
		HudManager.FlashFeedback("error")
		return
	end
	local plotId, pos, launcherIndex = entry.plotId, aimPos, pendingLauncherIndex
	-- Сначала закрываем UI/восстанавливаем камеру — затем сервер перехватит камеру
	-- под облёт ракеты (RocketFollow), стартовав с обычной камеры игрока.
	HudManager.CloseTargeting()
	Remotes.Get("LaunchRocket"):FireServer(plotId, pos, launcherIndex)
end

-- Клик по 3D-миру в режиме прицела: ставим/переставляем маркер удара.
local function onWorldClick(input, gpe)
	if gpe then return end
	if not targetingActive or targetIndex == 0 then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	local entry = targets[targetIndex]
	if not entry then return end
	local part = mouse.Target
	if not part then return end
	local plotId = findClickedPlot(part)
	if plotId ~= entry.plotId then
		setHint("Кликните по выбранному острову", Color3.fromRGB(255, 180, 40))
		return
	end
	aimPos = mouse.Hit.Position
	showMarker(aimPos)
	setLaunchEnabled(true)
	setHint("Точка удара выбрана — жмите ЗАПУСК", Color3.fromRGB(98, 220, 144))
end

-- Создаёт ProximityPrompt на КАЖДОЙ своей установке. Стреляет ИМЕННО тот стенд,
-- у которого стоит игрок (передаём LauncherIndex). Удержание E короткое.
local function ensurePrompts()
	local myId = player:GetAttribute("PlotId")
	if myId == nil then return end
	local plotFolder = workspace:FindFirstChild("Plot_" .. myId)
	local silo = plotFolder and plotFolder:FindFirstChild("RocketSilo")
	if not silo then return end
	for _, launcher in ipairs(silo:GetChildren()) do
		if launcher:IsA("Model") and not launcher:FindFirstChild("LaunchPrompt", true) then
			local pad = launcher.PrimaryPart or launcher:FindFirstChild("Pad")
			if pad then
				local prompt = Instance.new("ProximityPrompt")
				prompt.Name = "LaunchPrompt"
				prompt.ActionText = "Запуск ракеты"
				prompt.ObjectText = "Ракетная установка"
				prompt.HoldDuration = 0.25
				prompt.KeyboardKeyCode = Enum.KeyCode.E
				prompt.RequiresLineOfSight = false
				prompt.MaxActivationDistance = 16
				prompt.Parent = pad
				prompt.Triggered:Connect(function()
					HudManager.OpenTargeting(launcher:GetAttribute("LauncherIndex"))
				end)
			end
		end
	end
end

-- Прицел недействителен, если своя установка исчезла (напр. игрок сброшен с плота).
local function targetingStillValid()
	local myId = player:GetAttribute("PlotId")
	if myId == nil then return false end
	local plotFolder = workspace:FindFirstChild("Plot_" .. myId)
	local silo = plotFolder and plotFolder:FindFirstChild("RocketSilo")
	return silo ~= nil and #silo:GetChildren() > 0
end

-- Красивое число с разделением тысяч: 1234567 → "1 234 567".
local function formatMoney(n)
	local s = tostring(math.floor((n or 0) + 0.5))
	local formatted = (s:reverse():gsub("(%d%d%d)", "%1 ")):reverse()
	return (formatted:gsub("^%s+", ""))
end

-- === Attack-меню: список ракет с кнопками «ОТПРАВИТЬ» ===
local function updateRowStates()
	for i, rec in pairs(rowButtons) do
		local ends = reloadEndsAt[i]
		local ready = not (ends and ends > os.clock())
		if ready then
			rec.btn.Text = "ОТПРАВИТЬ"
			rec.btn.BackgroundColor3 = Color3.fromRGB(205, 67, 55)
			rec.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			rec.btn.AutoButtonColor = true
		else
			rec.btn.Text = string.format("%dс", math.max(1, math.ceil(ends - os.clock())))
			rec.btn.BackgroundColor3 = Color3.fromRGB(60, 66, 74)
			rec.btn.TextColor3 = Color3.fromRGB(160, 168, 176)
			rec.btn.AutoButtonColor = false
		end
	end
end

local function rebuildAttackRows()
	if not attackPanel then return end
	for _, child in ipairs(attackPanel:GetChildren()) do
		if child.Name == "RocketRow" then child:Destroy() end
	end
	rowButtons = {}
	for i = 1, launcherCount do
		local row = Instance.new("Frame")
		row.Name = "RocketRow"
		row.BackgroundColor3 = Color3.fromRGB(26, 33, 42)
		row.BackgroundTransparency = 0.15
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, -16, 0, 46)
		row.Position = UDim2.new(0, 8, 0, 38 + (i - 1) * 52)
		row.Parent = attackPanel
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(0, 10)
		rc.Parent = row

		makeLabel(row, string.format("🚀 Ракета %d · ур.%d", i, rocketLevels[i] or 1), UDim2.new(1, -116, 1, 0), UDim2.new(0, 10, 0, 0), Color3.fromRGB(230, 236, 240), 14, Enum.Font.GothamBold)

		local btn = makeButton(row, "ОТПРАВИТЬ", UDim2.new(0, 96, 0, 32), UDim2.new(1, -104, 0.5, -16), Color3.fromRGB(205, 67, 55))
		btn.TextSize = 13
		local index = i
		btn.MouseButton1Click:Connect(function()
			if targetingActive then return end
			local ends = reloadEndsAt[index]
			if ends and ends > os.clock() then return end
			HudManager.OpenTargeting(index)
		end)
		rowButtons[i] = { btn = btn }
	end
	attackPanel.Size = UDim2.new(0, 252, 0, 38 + launcherCount * 52 + 8)
	updateRowStates()
end

function HudManager.Init(initAnimEnabled)
	animEnabled = initAnimEnabled ~= false

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "TycoonHud"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	screenGui.Parent = playerGui

	-- === Деньги: внизу, горизонтально по центру, слева круглый логотип бакса ===
	local moneyBar = makeFrame(screenGui, UDim2.new(0, 230, 0, 56), UDim2.new(0.5, -115, 1, -72), Color3.fromRGB(14, 18, 24), 0.08, "MoneyBar")
	moneyBar:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 28)
	moneyStroke = Instance.new("UIStroke")
	moneyStroke.Color = GOLD_STROKE
	moneyStroke.Transparency = 0.72
	moneyStroke.Thickness = 1.4
	moneyStroke.Parent = moneyBar

	-- Якорь по центру: масштабирование «пульса» идёт от центра, логотип всегда
	-- отцентрован по вертикали.
	local logo = Instance.new("Frame")
	logo.Name = "DollarLogo"
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Size = UDim2.new(0, 40, 0, 40)
	logo.Position = UDim2.new(0, 28, 0.5, 0)
	logo.BackgroundColor3 = Color3.fromRGB(52, 206, 118)
	logo.BorderSizePixel = 0
	logo.Parent = moneyBar
	local logoCorner = Instance.new("UICorner")
	logoCorner.CornerRadius = UDim.new(1, 0)
	logoCorner.Parent = logo
	moneyLogoScale = Instance.new("UIScale")
	moneyLogoScale.Parent = logo

	local dollar = makeLabel(logo, "$", UDim2.new(1, 0, 1, 0), UDim2.new(), Color3.fromRGB(255, 255, 255), 24, Enum.Font.GothamBlack)
	dollar.TextXAlignment = Enum.TextXAlignment.Center

	moneyText = makeLabel(moneyBar, "0", UDim2.new(1, -66, 1, 0), UDim2.new(0, 58, 0, 0), GOLD_TEXT, 22, Enum.Font.GothamBold)
	moneyText.TextXAlignment = Enum.TextXAlignment.Left
	moneyText.TextYAlignment = Enum.TextYAlignment.Center

	-- === Кнопка ATTACK (слева, вертикально по центру) ===
	attackBtn = makeButton(screenGui, "", UDim2.new(0, 68, 0, 68), UDim2.new(0, 12, 0.5, -34), Color3.fromRGB(178, 52, 44))
	attackBtn:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 18)
	local attackStroke = Instance.new("UIStroke")
	attackStroke.Color = Color3.fromRGB(255, 120, 100)
	attackStroke.Transparency = 0.55
	attackStroke.Thickness = 1.4
	attackStroke.Parent = attackBtn
	local attackIcon = makeLabel(attackBtn, "🚀", UDim2.new(1, 0, 0, 34), UDim2.new(0, 0, 0, 6), Color3.fromRGB(255, 255, 255), 24)
	attackIcon.TextXAlignment = Enum.TextXAlignment.Center
	local attackText = makeLabel(attackBtn, "ATTACK", UDim2.new(1, 0, 0, 16), UDim2.new(0, 0, 0, 42), Color3.fromRGB(255, 230, 225), 12, Enum.Font.GothamBlack)
	attackText.TextXAlignment = Enum.TextXAlignment.Center

	-- Панель Attack: «Ракета N — ОТПРАВИТЬ», стрелять можно без подхода к стендам.
	attackPanel = makeCanvasPanel(screenGui, UDim2.new(0, 252, 0, 150), UDim2.new(0, 88, 0.5, 0), "AttackPanel")
	attackPanel.AnchorPoint = Vector2.new(0, 0.5)
	local attackTitle = makeLabel(attackPanel, "РАКЕТНЫЙ УДАР", UDim2.new(1, -20, 0, 26), UDim2.new(0, 12, 0, 6), Color3.fromRGB(236, 108, 91), 14, Enum.Font.GothamBold)
	attackTitle.TextXAlignment = Enum.TextXAlignment.Left

	attackBtn.MouseButton1Click:Connect(function()
		if targetingActive then return end
		attackOpen = not attackOpen
		if attackOpen then
			rebuildAttackRows()
		end
		fadePanel(attackPanel, attackOpen)
	end)

	-- === Шестерёнка настроек (правый нижний угол) ===
	gearBtn = makeButton(screenGui, "⚙️", UDim2.new(0, 46, 0, 46), UDim2.new(1, -58, 1, -58), Color3.fromRGB(22, 28, 36))
	gearBtn:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	gearBtn.TextSize = 22

	settingsPanel = makeCanvasPanel(screenGui, UDim2.new(0, 264, 0, 64), UDim2.new(1, -276, 1, -130), "SettingsPanel")

	makeLabel(settingsPanel, "Анимация полёта ракеты", UDim2.new(1, -102, 1, 0), UDim2.new(0, 14, 0, 0), Color3.fromRGB(218, 226, 232), 14)

	animToggleBtn = makeButton(settingsPanel, "ВКЛ", UDim2.new(0, 74, 0, 34), UDim2.new(1, -84, 0.5, -17), Color3.fromRGB(52, 190, 110))
	local function refreshToggle()
		animToggleBtn.Text = animEnabled and "ВКЛ" or "ВЫКЛ"
		animToggleBtn.BackgroundColor3 = animEnabled and Color3.fromRGB(52, 190, 110) or Color3.fromRGB(90, 98, 108)
	end
	refreshToggle()

	-- Клик по шестерёнке: анимация прокрутки + панель плавно проявляется/гаснет.
	gearBtn.MouseButton1Click:Connect(function()
		settingsOpen = not settingsOpen
		TweenService:Create(gearBtn, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = gearBtn.Rotation + 180 }):Play()
		fadePanel(settingsPanel, settingsOpen)
	end)
	animToggleBtn.MouseButton1Click:Connect(function()
		animEnabled = not animEnabled
		refreshToggle()
		-- Сохраняется НАВСЕГДА (DataStore на сервере, см. DataManager).
		Remotes.Get("SetAnimSetting"):FireServer(animEnabled)
	end)

	-- === Верхняя плашка прицеливания: ◀ [ник] ▶ и ✕ ===
	topBar = makeFrame(screenGui, UDim2.new(0, 460, 0, 68), UDim2.new(0.5, -230, 0, 14), Color3.fromRGB(14, 18, 24), 0.12, "TargetBar")
	topBar:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 16)
	topBar.Visible = false

	local prevBtn = makeButton(topBar, "◀", UDim2.new(0, 52, 1, -16), UDim2.new(0, 8, 0, 8), Color3.fromRGB(36, 44, 52))
	prevBtn.TextSize = 22
	local nextBtn = makeButton(topBar, "▶", UDim2.new(0, 52, 1, -16), UDim2.new(1, -60, 0, 8), Color3.fromRGB(36, 44, 52))
	nextBtn.TextSize = 22

	ownerLabel = makeLabel(topBar, "—", UDim2.new(1, -140, 0, 30), UDim2.new(0, 70, 0, 8), Color3.fromRGB(255, 255, 255), 20, Enum.Font.GothamBold)
	ownerLabel.TextXAlignment = Enum.TextXAlignment.Center
	islandLabel = makeLabel(topBar, "", UDim2.new(1, -140, 0, 20), UDim2.new(0, 70, 0, 40), Color3.fromRGB(160, 175, 182), 13)
	islandLabel.TextXAlignment = Enum.TextXAlignment.Center

	-- ✕ прижата к правому верхнему углу плашки (снаружи)
	local closeBtn = makeButton(topBar, "✕", UDim2.new(0, 34, 0, 34), UDim2.new(1, 10, 0, 0), Color3.fromRGB(73, 82, 86))

	prevBtn.MouseButton1Click:Connect(function() selectTarget(targetIndex - 1) end)
	nextBtn.MouseButton1Click:Connect(function() selectTarget(targetIndex + 1) end)
	closeBtn.MouseButton1Click:Connect(function() HudManager.CloseTargeting() end)

	-- Подсказка под плашкой
	hintLabel = makeLabel(screenGui, "", UDim2.new(0, 680, 0, 22), UDim2.new(0.5, -340, 0, 88), Color3.fromRGB(255, 214, 90), 14)
	hintLabel.TextXAlignment = Enum.TextXAlignment.Center
	hintLabel.Visible = false

	-- Большая кнопка запуска (над денежной панелью)
	launchButton = makeButton(screenGui, "🚀  ЗАПУСК", UDim2.new(0, 260, 0, 58), UDim2.new(0.5, -130, 1, -148), Color3.fromRGB(60, 66, 74))
	launchButton:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 29)
	launchButton.TextSize = 20
	launchButton.Visible = false
	launchButton.Active = false
	launchButton.AutoButtonColor = false
	launchButton.MouseButton1Click:Connect(doLaunch)

	-- Ввод: клики мыши ставят точку удара; A/D/стрелки листают острова; Q — выход.
	UserInputService.InputBegan:Connect(function(input, gpe)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			onWorldClick(input, gpe)
			return
		end
		if gpe then return end
		if not targetingActive then return end
		if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
			selectTarget(targetIndex - 1)
		elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
			selectTarget(targetIndex + 1)
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Escape then
			HudManager.CloseTargeting()
		end
	end)

	-- Смерть/респавн: сбрасываем прицел и любые изменения ввода/камеры.
	local function bindCharacter(char)
		humFrozen = false
		if targetingActive then HudManager.CloseTargeting() end
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
		if hum then
			hum.Died:Connect(function()
				if targetingActive then HudManager.CloseTargeting() end
			end)
		end
	end
	player.CharacterAdded:Connect(bindCharacter)
	-- В отдельном потоке: bindCharacter может ждать Humanoid и не должен блокировать старт.
	if player.Character then task.spawn(bindCharacter, player.Character) end

	-- Обновляем цели при входе/выходе игроков, пока прицел открыт (текущий остров сохраняем).
	local function maybeRefresh()
		task.wait(0.4)
		if not targetingActive then return end
		local currentPlotId = targets[targetIndex] and targets[targetIndex].plotId
		targets = collectTargets()
		if #targets == 0 then
			HudManager.CloseTargeting()
			return
		end
		local newIndex = 1
		for i, entry in ipairs(targets) do
			if entry.plotId == currentPlotId then
				newIndex = i
				break
			end
		end
		targetIndex = newIndex
		updateHeader()
	end
	Players.PlayerAdded:Connect(maybeRefresh)
	Players.PlayerRemoving:Connect(maybeRefresh)

	-- Поддержка prompt'ов и проверка валидности прицела (исчезновение установки).
	task.spawn(function()
		while true do
			ensurePrompts()
			if targetingActive and not targetingStillValid() then
				HudManager.CloseTargeting()
				HudManager.FlashFeedback("error")
			end
			task.wait(1)
		end
	end)

	-- Тикающий отсчёт перезарядки в открытом Attack-меню.
	task.spawn(function()
		while true do
			if attackPanel and attackPanel.Visible then
				updateRowStates()
			end
			task.wait(0.4)
		end
	end)
end

function HudManager.UpdateData(data)
	rocketLevels = data.rocketLevels or rocketLevels
	if attackPanel and attackPanel.Visible then
		rebuildAttackRows()
	end

	local target = data.money or 0
	if not moneyText then return end

	-- Плавный "отсчёт" суммы + пульс логотипа при изменении.
	if moneyThread then task.cancel(moneyThread) end
	local from = shownMoney
	if from ~= target and moneyLogoScale then
		-- Гасим предыдущий пульс и сбрасываем масштаб (иначе логотип «уезжал»).
		if moneyPopTween then moneyPopTween:Cancel() end
		moneyLogoScale.Scale = 1
		moneyPopTween = TweenService:Create(moneyLogoScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Scale = 1.15 })
		moneyPopTween:Play()
	end
	moneyThread = task.spawn(function()
		local t0 = os.clock()
		local duration = 0.4
		while true do
			local a = math.min((os.clock() - t0) / duration, 1)
			local v = math.floor(from + (target - from) * a + 0.5)
			shownMoney = v
			moneyText.Text = formatMoney(v)
			if a >= 1 then break end
			RunService.RenderStepped:Wait()
		end
	end)
end

function HudManager.UpdateRocketState(data)
	rocketReady = data.ready or 0
	launcherCount = data.launchers or launcherCount
	reloadEndsAt = {}
	for index, seconds in pairs(data.reloads or {}) do
		if type(index) == "number" and type(seconds) == "number" then
			reloadEndsAt[index] = os.clock() + seconds
		end
	end
	if attackPanel and attackPanel.Visible then
		rebuildAttackRows()
	end
end

function HudManager.IsAnimEnabled()
	return animEnabled
end

return HudManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PriceTags</string>
            <string name="Source"><![CDATA[-- PriceTags.luau — ценники (BillboardGui "PriceTag") видны ТОЛЬКО на своём острове
-- и ТОЛЬКО когда игрок стоит рядом с кнопкой. Появление и исчезновение ПЛАВНЫЕ:
-- подходишь — текст мягко проявляется, отходишь — мягко тает.
-- Сервер выставляет атрибут Unlocked и держит Enabled = false; клиент управляет
-- прозрачностью текста по владению + дистанции.
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local PriceTags = {}

local SHOW_DISTANCE = 22
local FADE_STEP = 0.22 -- доля пути к цели за тик (~0.45с на полный фейд)

-- Кэш ценников: { gui, part, label, plotId, alpha }. Пересобираем редко,
-- дистанцию и фейд обсчитываем часто.
local cache = {}

local function rebuildCache()
	local found = {}
	for _, folder in ipairs(workspace:GetChildren()) do
		local pid = folder:GetAttribute("PlotId")
		if pid ~= nil then
			for _, gui in ipairs(folder:GetDescendants()) do
				if gui:IsA("BillboardGui") and gui.Name == "PriceTag" then
					local part = gui.Parent
					local label = gui:FindFirstChild("PriceLabel")
					if part and part:IsA("BasePart") and label then
						-- Сохраняем прежний альфа-прогресс, если ценник уже был в кэше.
						local alpha = 1
						for _, old in ipairs(cache) do
							if old.gui == gui then
								alpha = old.alpha
								break
							end
						end
						table.insert(found, { gui = gui, part = part, label = label, plotId = pid, alpha = alpha })
					end
				end
			end
		end
	end
	cache = found
end

local function refresh()
	local myId = player:GetAttribute("PlotId")
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	for _, entry in ipairs(cache) do
		if entry.gui.Parent then
			local wantVisible = false
			if myId ~= nil and entry.plotId == myId and hrp and entry.gui:GetAttribute("Unlocked") == true then
				wantVisible = (entry.part.Position - hrp.Position).Magnitude < SHOW_DISTANCE
			end

			-- Плавный фейд: alpha 0 = полностью виден, 1 = полностью скрыт.
			local target = wantVisible and 0 or 1
			entry.alpha += (target - entry.alpha) * FADE_STEP
			if math.abs(entry.alpha - target) < 0.02 then
				entry.alpha = target
			end

			entry.label.TextTransparency = entry.alpha
			entry.label.TextStrokeTransparency = 0.35 + 0.65 * entry.alpha
			entry.gui.Enabled = entry.alpha < 0.99
		end
	end
end

function PriceTags.Init()
	rebuildCache()
	player:GetAttributeChangedSignal("PlotId"):Connect(refresh)

	-- Новые ценники появляются при покупках — кэш пересобираем раз в 2с.
	task.spawn(function()
		while true do
			task.wait(2)
			rebuildCache()
		end
	end)

	-- Частый тик: дистанция + плавный фейд.
	task.spawn(function()
		while true do
			refresh()
			task.wait(0.08)
		end
	end)
end

return PriceTags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">RocketAnim</string>
            <string name="Source"><![CDATA[-- RocketAnim.luau - кинокамера стрелка следует за СЕРВЕРНОЙ ракетой; взрыв с
-- настоящим чёрным дымом при прилёте. ЛКМ во время полёта пропускает анимацию
-- (камера сразу возвращается к персонажу, ракета долетает сама).
local Players           = game:GetService("Players")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local Debris            = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config            = require(sharedFolder:WaitForChild("Config"))

local player = Players.LocalPlayer

local RocketAnim = {}

local SMOKE_TEXTURE = "rbxassetid://241594419"

local function spawnExplosion(pos)
	-- Настоящий Explosion (без урона игрокам) + вспышка и ударное кольцо.
	local explosion = Instance.new("Explosion")
	explosion.Position = pos
	explosion.BlastRadius = 24
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace

	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(2, 2, 2)
	ball.Position = pos
	ball.Anchored = true
	ball.CanCollide = false
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 140, 20)
	ball.Parent = workspace

	local ballTween = TweenService:Create(ball,
		TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(22, 22, 22), Transparency = 1 })
	ballTween:Play()
	Debris:AddItem(ball, 0.5)

	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.6, 2, 2)
	ring.Position = pos
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 60, 20)
	ring.Orientation = Vector3.new(0, 0, 90)
	ring.Parent = workspace

	local ringTween = TweenService:Create(ring,
		TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.6, 30, 30), Transparency = 1 })
	ringTween:Play()
	Debris:AddItem(ring, 0.6)

	-- Холдер живёт дольше всех эффектов — на нём и дым, и звук (раньше звук был
	-- приделан к шару-вспышке и ОБРЫВАЛСЯ через 0.5с вместе с ним).
	local smokeHolder = Instance.new("Part")
	smokeHolder.Size = Vector3.new(1, 1, 1)
	smokeHolder.Position = pos + Vector3.new(0, 2, 0)
	smokeHolder.Anchored = true
	smokeHolder.CanCollide = false
	smokeHolder.Transparency = 1
	smokeHolder.Parent = workspace

	-- Звук взрыва: плавный ВХОД (без резкого щелчка в начале), реверб-хвост и
	-- плавный ВЫХОД — звучит мягче и не обрезается с двух концов.
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://5801257793"
	sound.Volume = 0
	sound.PlaybackSpeed = 0.95
	sound.RollOffMaxDistance = 400
	sound.RollOffMinDistance = 20
	sound.Parent = smokeHolder

	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 1.5
	reverb.Density = 0.8
	reverb.WetLevel = -8
	reverb.Parent = sound

	sound:Play()
	TweenService:Create(sound, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Volume = 0.85 }):Play()
	task.delay(1.3, function()
		if sound.Parent then
			TweenService:Create(sound, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Volume = 0 }):Play()
		end
	end)

	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "ImpactSmoke"
	smoke.Texture = SMOKE_TEXTURE
	smoke.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 28, 30)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(52, 52, 55)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(96, 96, 100)),
	})
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 5),
		NumberSequenceKeypoint.new(0.35, 10),
		NumberSequenceKeypoint.new(1, 16),
	})
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.12),
		NumberSequenceKeypoint.new(0.6, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Lifetime = NumberRange.new(1.4, 2.6)
	smoke.Speed = NumberRange.new(10, 20)
	smoke.SpreadAngle = Vector2.new(85, 85)
	smoke.Acceleration = Vector3.new(0, 7, 0)
	smoke.Drag = 1.2
	smoke.Rotation = NumberRange.new(-180, 180)
	smoke.RotSpeed = NumberRange.new(-40, 40)
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.Rate = 0
	smoke.Parent = smokeHolder

	-- Короткая огненная вспышка внутри дыма.
	local fire = Instance.new("ParticleEmitter")
	fire.Name = "ImpactFire"
	fire.Texture = SMOKE_TEXTURE
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 150, 40), Color3.fromRGB(200, 60, 20))
	fire.LightEmission = 0.9
	fire.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 3),
		NumberSequenceKeypoint.new(1, 7),
	})
	fire.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	fire.Lifetime = NumberRange.new(0.3, 0.6)
	fire.Speed = NumberRange.new(14, 26)
	fire.SpreadAngle = Vector2.new(70, 70)
	fire.EmissionDirection = Enum.NormalId.Top
	fire.Rate = 0
	fire.Parent = smokeHolder

	smoke:Emit(45)
	fire:Emit(25)
	Debris:AddItem(smokeHolder, 4.5)
end

-- Камера стрелка ведёт СЕРВЕРНУЮ ракету (её инстанс приходит по RocketFollow),
-- пока сервер её не уничтожит; затем плавно возвращает управление игроку.
-- Клик ЛКМ (или тап) в любой момент ПРОПУСКАЕТ анимацию: камера сразу к игроку.
function RocketAnim.Follow(rocketModel, animEnabled)
	if not animEnabled then return end
	if typeof(rocketModel) ~= "Instance" then return end
	local root = rocketModel.PrimaryPart or rocketModel:FindFirstChild("Root")
	if not root then return end

	local camera = workspace.CurrentCamera
	if not camera then return end
	local prevType = camera.CameraType
	local prevSubject = camera.CameraSubject
	camera.CameraType = Enum.CameraType.Scriptable

	task.spawn(function()
		local skipped = false
		local skipConn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				skipped = true
			end
		end)

		local lastPos = root.Position
		local startT = os.clock()
		-- Летящая ракета крупнее прежней — камера чуть дальше и выше.
		while rocketModel.Parent and root.Parent and not skipped and (os.clock() - startT) < (Config.ROCKET_ANIM_TIME + 3) do
			local pos = root.Position
			local look = root.CFrame.LookVector
			if look.Magnitude < 0.001 then look = Vector3.new(0, 0, -1) end
			local side = look:Cross(Vector3.new(0, 1, 0))
			local camPos = pos - look * 30 + Vector3.new(0, 12, 0) + side * 7
			camera.CFrame = CFrame.lookAt(camPos, pos + look * 6)
			lastPos = pos
			RunService.RenderStepped:Wait()
		end

		skipConn:Disconnect()

		if skipped then
			-- Пропуск: мгновенно возвращаем обычную камеру (ракета долетит сама).
			camera.CameraType = prevType or Enum.CameraType.Custom
			if prevSubject then camera.CameraSubject = prevSubject end
			return
		end

		-- Вид сверху на точку взрыва, затем плавный возврат к персонажу.
		local topView = CFrame.lookAt(lastPos + Vector3.new(0, 95, 0.05), lastPos)
		camera.CFrame = topView
		task.wait(0.8)

		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local endCF = CFrame.lookAt(hrp.Position + Vector3.new(0, 6, 14), hrp.Position)
			for s = 1, 14 do
				if camera.CameraType ~= Enum.CameraType.Scriptable then break end
				camera.CFrame = topView:Lerp(endCF, s / 14)
				RunService.RenderStepped:Wait()
			end
		end

		camera.CameraType = prevType or Enum.CameraType.Custom
		if prevSubject then camera.CameraSubject = prevSubject end
	end)
end

-- Прилёт: взрыв + дым + звук в точке удара (без текстовых уведомлений).
function RocketAnim.Impact(data)
	if not data or not data.pos then return end
	spawnExplosion(data.pos)
end

return RocketAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Sprint.luau — ускорение на Shift: персонаж бежит немного быстрее,
-- камера слегка расширяет FOV для ощущения скорости.
local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sharedFolder      = ReplicatedStorage:WaitForChild("Shared", 10)

local Config = require(sharedFolder:WaitForChild("Config"))

local player = Players.LocalPlayer

local Sprint = {}

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function isShiftDown()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

local function apply()
	local hum = getHumanoid()
	if not hum or hum.Health <= 0 then return end
	-- WalkSpeed == 0 означает заморозку (режим прицеливания HudManager) — не трогаем.
	if hum.WalkSpeed == 0 then return end

	local sprinting = isShiftDown()
	hum.WalkSpeed = sprinting and Config.SPRINT_SPEED or Config.WALK_SPEED

	local camera = workspace.CurrentCamera
	if camera and camera.CameraType ~= Enum.CameraType.Scriptable then
		TweenService:Create(camera, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			FieldOfView = sprinting and 74 or 70,
		}):Play()
	end
end

function Sprint.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			apply()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			apply()
		end
	end)

	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.WalkSpeed = Config.WALK_SPEED
		end
	end)
end

return Sprint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">VisualFX</string>
            <string name="Source"><![CDATA[-- VisualFX.luau — Визуальные 3D эффекты: всплывающие деньги +$Cash над зданиями
local TweenService = game:GetService("TweenService")
local Debris       = game:GetService("Debris")

local VisualFX = {}

function VisualFX.SpawnIncome(pos, amount)
	local part = Instance.new("Part")
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Position = pos
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Parent = workspace

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 120, 0, 40)
	bb.StudsOffset = Vector3.new(0, 0, 0)
	bb.AlwaysOnTop = true
	bb.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "+$" .. amount
	label.TextColor3 = Color3.fromRGB(60, 255, 100)
	label.TextStrokeColor3 = Color3.fromRGB(0, 50, 0)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.Parent = bb

	-- Анимация взлета вверх и растворения
	local tweenInfo = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local moveTween = TweenService:Create(part, tweenInfo, { Position = pos + Vector3.new(0, 8, 0) })
	local fadeTween = TweenService:Create(label, tweenInfo, { TextTransparency = 1, TextStrokeTransparency = 1 })

	moveTween:Play()
	fadeTween:Play()

	Debris:AddItem(part, 1.5)
end

return VisualFX
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="26">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>